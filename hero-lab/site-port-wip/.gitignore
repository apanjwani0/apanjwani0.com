# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# credentials — service-account keys, API exports, anything handed to a script.
# Listed before the directory exists on purpose: a key is committed by the same
# mistake that creates the folder, and .gitignore only helps if it got there first.
secrets/
*service-account*.json
*credentials*.json

# macOS-specific files
.DS_Store

# personal media — keep off version control
public/avatar.*
*.zip

# runtime config data (written by /admin, not source-controlled)
data/*.json

# jetbrains setting folder
.idea/

# wrangler local state (may contain tokens/credentials)
.wrangler/

# agent / AI tooling
.claude/
.codex/
.agents/

# project docs not intended for public repo
CLAUDE.md
SECURITY_REVIEW.md

# generated poker asset preview (regenerate with `npm run poker:catalogue`)
docs/poker-assets.html

# local PocketBase backend — binary is platform-specific, data is local state.
# Reproducible via `npm run pb` (downloads binary) + committed pb_migrations/ schema.
pocketbase/pocketbase
pocketbase/pb_data/

# graphify output — local-only generated code-graph (an AI navigation aid wired
# via .claude/ hooks; regenerate locally with `graphify update .`, zero API cost).
# NOTE: git does NOT support inline (end-of-line) comments — keep comments on
# their own lines, or the pattern silently matches nothing.
# Keep only the human-readable report in git; everything else stays local.
graphify-out/*
!graphify-out/GRAPH_REPORT.md

# Scratch HTML that scripts/generate-og.mjs rasterises into public/og/.
# Normally removed when the script finishes; survives an interrupted run.
.og-tmp/