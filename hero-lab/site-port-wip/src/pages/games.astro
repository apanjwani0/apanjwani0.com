---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite, getGames } from '../lib/config'
import { render } from '../lib/markdown'
import { itemListJsonLd } from '../lib/jsonld'
import { isPlayableGame } from '../lib/games'

const [site, games] = await Promise.all([
  getSite(Astro.locals),
  getGames(Astro.locals).then(gs => gs.filter(g => g.enabled)),
])
const cspNonce = (Astro.locals as any).cspNonce

// Only playable games have an indexable detail page; the "coming soon"
// placeholders render noindex, so keep them out of the structured item list.
// Same predicate as the sitemap and the detail page's robots meta, so the three
// cannot disagree. The card grid below still shows every enabled game.
const ldJson = itemListJsonLd(
  'Games by Aman Panjwani',
  games.filter(isPlayableGame).map(g => ({ name: g.title, url: `${site.url}/games/${g.slug}` })),
)

// Kept under ~155 characters deliberately — same reasoning as /tools: a snippet
// is truncated past roughly that, so the tail is downloaded by every crawler and
// read by no one (the previous version ran to 279). The full shelf is in the page
// intro below and the long-tail terms are in `keywords`. Declared here, not as an
// inline JSX comment between attributes — that form builds green while breaking
// `astro check` (see AGENTS.md).
const metaDescription =
  'Free browser games, no sign-up: a daily word puzzle, a typing race with ghost ' +
  'replays, a hex-colour game, a fractal deep-zoom, 2048 and a poker trainer.'
---

<Base
  wide
  starfield={false}
  title="games"
  seoTitle="Free Browser Games — Daily Word Puzzle, Typing Race & More"
  description={metaDescription}
  keywords="browser games, word game, word guessing game, five letter word game, daily word puzzle, wordle style game, quintle, 2048, 2048 puzzle, sliding tile game, number puzzle, maze generator, maze solver, pathfinding visualizer, bfs, a star, typing game, typing speed test, typing race, daily typing challenge, typing leaderboard, hex color game, color guessing game, guess the hex, daily color game, poker trainer, poker equity calculator, pot odds trainer, poker practice, mandelbrot set explorer, julia set generator, fractal zoom, fractal explorer online, daily games, daily puzzle, no-download games, playable experiments"
>
  {games.length > 0 && <script nonce={cspNonce} type="application/ld+json" set:html={ldJson} />}
  <h1>games</h1>
  <p data-type="page-intro">
    Browser games and playable experiments — no downloads, no sign-up. Three
    have a daily round that is the same for everyone, and your streak stays in
    your browser. The generative pieces moved to{' '}
    <a href="/tools/driftfield">Driftfield</a>.
  </p>
  {games.length === 0 ? (
    <p>Coming soon.</p>
  ) : (
    <div data-type="card-grid">
      {games.map(g => (
        <article data-type="project">
          <div data-type="project-header">
            <h2 data-type="card-title"><a href={`/games/${g.slug}`}>{g.title}</a></h2>
            <span data-type="project-stats">
              {isPlayableGame(g) ? (
                <span data-type="game-badge" data-live>play <span aria-hidden="true">&rsaquo;</span></span>
              ) : (
                <span data-type="game-badge">coming soon</span>
              )}
            </span>
          </div>
          {/* First paragraph only. The full description is the product copy
              for /games/<slug> and runs to three paragraphs (Deep Shore is
              1,074 characters), which on a card made one column three times
              the height of its neighbours and buried the eight titles this
              page exists to let you scan. `intro` is not the answer — only 2
              of 8 games have one — but every description's first paragraph is
              already written as its summary. */}
          <div data-type="project-description" set:html={render(g.description.split(/\n\s*\n/)[0])} />
        </article>
      ))}
    </div>
  )}
</Base>

{/* Badge CSS lives in global.css (not a scoped <style> here) because the
    daily-streak strip inserts a third badge state at runtime, and a
    JS-created element never carries Astro's scoping attribute — a scoped
    rule cannot style it. */}

<script>
  import { registerDailyStreaks } from '../lib/daily-streak-strip'
  registerDailyStreaks()
</script>
