# ── GitHub stats (optional) ────────────────────────────────────────────────────
# Personal access token (no scopes needed for public repos).
# Without this, the GitHub API allows 60 requests/hr per IP.
# With this, the limit rises to 5000/hr.
GITHUB_TOKEN=

# ── Admin panel (DEV ONLY) ─────────────────────────────────────────────────────
# /admin and every /api/admin/* route return 404 in production — the surface does
# not exist there, so this is never needed on the server and must not be set in
# the production container. Leave unset locally to skip the login entirely; set it
# to require a password on your dev machine.
ADMIN_SECRET=

# ── Origin lock (production only, optional) ────────────────────────────────────
# The origin has a public IP with port 80 open, so Cloudflare can be bypassed by
# anyone who resolves it. Set this to a long random value AND add a Cloudflare
# Transform Rule that injects the same value as the `x-origin-auth` request
# header; the middleware then 404s anything that did not come through Cloudflare.
#   openssl rand -hex 32
# Leave EMPTY until the Transform Rule exists — an empty value disables the check,
# so a half-finished setup cannot take the site offline.
ORIGIN_SHARED_SECRET=

# ── Docker deployment (optional) ───────────────────────────────────────────────
# Used by scripts/deploy-cloud.sh when no positional argument is given.
# Format: registry/image:tag  (e.g. ghcr.io/your-username/portfolio:latest)
DOCKER_IMAGE=ghcr.io/your-username/portfolio:latest

# ── Cloudflare Workers deployment (optional) ───────────────────────────────────
# KV namespace IDs go in wrangler.jsonc, not here.
# Set the admin secret as a Cloudflare secret instead:
#   npx wrangler secret put ADMIN_SECRET
