---
export const prerender = false

import Base from '../../layouts/Base.astro'
import { getSite, getGames } from '../../lib/config'
import { render } from '../../lib/markdown'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import RelatedLinks from '../../components/RelatedLinks.astro'
import { breadcrumbListJsonLd, webAppJsonLd } from '../../lib/jsonld'
import { existingOgCardPath, gameHasOgCard } from '../../lib/og'
import { gameTag, isPlayableGame } from '../../lib/games'
import '../../styles/seo-support.css'
import '../../components/games/games-common.css'
import '../../components/games/twenty48/twenty48.css'
import '../../components/games/game-of-life/game-of-life.css'
import '../../components/games/flow-field/flow-field.css'
import '../../components/games/maze-weaver/maze-weaver.css'
import '../../components/games/type-trial/type-trial.css'
import '../../components/games/hue-hunt/hue-hunt.css'
import '../../components/games/starfield-toy/starfield.css'
import '../../components/games/murmuration/murmuration.css'
import '../../components/games/turing-bloom/turing-bloom.css'
import '../../components/games/sand-loom/sand-loom.css'
import '../../components/games/lsystem/lsystem.css'
import '../../components/games/quintle/quintle.css'

const { slug } = Astro.params
if (slug === 'wallpaper-forge') return Astro.redirect('/tools/wallpaper-forge', 301)

const [site, games] = await Promise.all([getSite(Astro.locals), getGames(Astro.locals)])
const cspNonce = (Astro.locals as any).cspNonce
const game = games.find(g => g.slug === slug && g.enabled)

if (!game) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

// For a "coming soon" page, point the visitor at a game that's actually
// playable right now so the page is an invitation, not a dead end.
const liveGame = games.find(g => isPlayableGame(g) && g.slug !== slug)
// Sibling links, so this page is not a dead end for a crawler or a visitor who
// arrived here from a search. Only playable games — the same set the sitemap and
// the hub's ItemList list, so nothing here points at a noindex page.
const relatedGames = games
  .filter(g => isPlayableGame(g) && g.slug !== slug)
  .map(g => ({ title: g.title, href: `/games/${g.slug}` }))
const pageDescription = game.metaDescription || game.description
const gameIntro = game.intro || game.description
const gameIntroHtml = render(gameIntro)
const gameSeoContentHtml = game.seoContent ? render(game.seoContent) : ''

const ldJson = webAppJsonLd({
  name: game.title,
  description: pageDescription,
  url: `${site.url}/games/${game.slug}`,
  authorName: site.name,
  authorUrl: site.url,
  applicationCategory: 'Game',
  alsoType: 'VideoGame',
  keywords: game.keywords,
})

// Visible trail + matching BreadcrumbList, emitted together on every game page.
// They must always agree: search engines only surface a breadcrumb path when the
// markup and the structured data match, so neither is emitted without the other.
// Interactive games render the trail above their component (which draws its own
// h1), exactly as the tool pages do.
const crumbs = [
  { label: 'home', href: '/' },
  { label: 'games', href: '/games' },
  { label: game.title },
]
const breadcrumbLd = breadcrumbListJsonLd([
  { name: 'Home', url: site.url },
  { name: 'Games', url: `${site.url}/games` },
  { name: game.title, url: `${site.url}/games/${game.slug}` },
])

// One custom-element tag per playable game. Every mount renders the identical
// body (h1 + intro), so a single dynamic-tag block replaces twelve copies that
// could only ever drift. A slug with no tag registered renders as "coming soon"
// — and because the sitemap and the share card read the same predicate from
// src/lib/games.ts, all three agree about that instead of contradicting.
const GameTag = gameTag(game)

// Card only when the generator emits one AND the PNG is really on disk — a
// forgotten `npm run og` must degrade to the avatar, not a 404ing og:image.
const ogCard = gameHasOgCard(game) ? await existingOgCardPath('games', game.slug) : undefined
---

<Base
  title={game.title}
  seoTitle={game.seoTitle}
  description={pageDescription}
  keywords={game.keywords}
  noindex={!GameTag}
  starfield={false}
  loadFonts={false}
  clientRouter={false}
  ogCard={ogCard}
>
  <script nonce={cspNonce} type="application/ld+json" set:html={ldJson} />
  <script nonce={cspNonce} type="application/ld+json" set:html={breadcrumbLd} />
  <Breadcrumbs items={crumbs} inset />
  {GameTag && (
    <GameTag data-game={game.slug}>
      <h1>{game.title}</h1>
      <div data-type="project-description" set:html={gameIntroHtml} />
    </GameTag>
  )}
  {!GameTag && (
    <>
      <h1>{game.title}</h1>
      <h2 data-type="coming-soon">Coming Soon</h2>
      <div data-type="project-description" set:html={gameIntroHtml} />
      {liveGame && (
        <p>
          Want to play something now? <a href={`/games/${liveGame.slug}`}>{liveGame.title}</a> is live and ready.
        </p>
      )}
    </>
  )}
  {gameSeoContentHtml && <section data-type="seo-support" set:html={gameSeoContentHtml} />}
  <RelatedLinks heading="More games" items={relatedGames} />

  {GameTag && (
    <script>
      // Mount the game's controller on initial load AND after every View Transition
      // navigation. Bundled scripts run only once per session, so without astro:page-load
      // a game reached via in-site nav renders blank until a hard reload.
      function mountGame() {
        const slug = document.querySelector('[data-game]')?.getAttribute('data-game')
        if (slug === 'quintle') import('../../components/games/quintle/Quintle.ts')
        else if (slug === '2048') import('../../components/games/twenty48/Twenty48.ts')
        else if (slug === 'game-of-life') import('../../components/games/game-of-life/GameOfLife.ts')
        else if (slug === 'flow-field') import('../../components/games/flow-field/FlowField.ts')
        else if (slug === 'maze-weaver') import('../../components/games/maze-weaver/MazeWeaver.ts')
        else if (slug === 'type-trial') import('../../components/games/type-trial/TypeTrial.ts')
        else if (slug === 'hue-hunt') import('../../components/games/hue-hunt/HueHunt.ts')
        else if (slug === 'starfield-toy') import('../../components/games/starfield-toy/Starfield.ts')
        else if (slug === 'murmuration') import('../../components/games/murmuration/Murmuration.ts')
        else if (slug === 'turing-bloom') import('../../components/games/turing-bloom/TuringBloom.ts')
        else if (slug === 'sand-loom') import('../../components/games/sand-loom/SandLoom.ts')
        else if (slug === 'lsystem-tree') import('../../components/games/lsystem/LSystem.ts')
      }
      document.addEventListener('astro:page-load', mountGame)
      mountGame()
    </script>
  )}
</Base>

<style>
  /* "Coming soon" subheading on the non-interactive game pages — muted, with
     space before the description. Was an inline style; moved here to a scoped
     data-type rule to match the project's no-inline-styles convention. Tokens
     only, so it renders identically. */
  h2[data-type="coming-soon"] {
    color: var(--color-muted);
    margin-bottom: var(--space-section);
  }
</style>
