---
export const prerender = false

import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard.astro'
import { getProjects } from '../lib/config'
import { getProjectStats } from '../lib/github'
import { itemListJsonLd } from '../lib/jsonld'
import { safeExternalUrl } from '../lib/security'

const projects = await getProjects(Astro.locals)
const stats    = await getProjectStats(projects)
const cspNonce = (Astro.locals as any).cspNonce

// Structured item map for the listing, matching /tools and /games — search
// engines get an explicit, ordered list of what's on the page.
const ldJson = itemListJsonLd(
  'Projects',
  projects.flatMap(p => {
    const url = safeExternalUrl(p.url)
    return url ? [{ name: p.title, url }] : []
  }),
)
---

<Base
  wide
  title="projects"
  description="Software projects by Aman Panjwani — payments infrastructure at scale, plus side projects and open-source experiments."
  keywords="aman panjwani projects, open source projects, payments infrastructure, backend side projects, github projects, software engineer portfolio"
>
  {projects.length > 0 && <script nonce={cspNonce} type="application/ld+json" set:html={ldJson} />}
  <h1>projects</h1>
  <p data-type="page-intro">
    Things I've shipped and things I tinker with — payments infrastructure by day,
    and side projects that exist mostly because I got curious.
  </p>
  <div data-type="card-grid">
    {projects.map(p => <ProjectCard project={p} stats={stats[p.url]} />)}
  </div>
</Base>
