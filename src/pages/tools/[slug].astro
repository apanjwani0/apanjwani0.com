---
export const prerender = false

import ToolBase from '../../layouts/ToolBase.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import JsonLd from '../../components/JsonLd.astro'
import RelatedLinks from '../../components/RelatedLinks.astro'
import { getSite, getTools, getLearnings } from '../../lib/config'
import { webAppJsonLd } from '../../lib/jsonld'
import { buildBreadcrumbs } from '../../lib/breadcrumbs'
import { existingOgCardPath, toolHasOgCard } from '../../lib/og'
import { render } from '../../lib/markdown'
import { validateSession } from '../../lib/session'
import { getSessionToken } from '../../lib/security'
import { learningsAboutEmbed } from '../../lib/learnings'
import { CRON_PRESETS, CRON_WHISPERER_SLUG, isCronWhispererPublic } from '../../lib/cron-presets'
import '../../styles/seo-support.css'
import toolsCommonCss from '../../components/tools/tools-common.css?url'

const { slug } = Astro.params

// Each tool's own stylesheet, linked on that tool's page only. A static import
// put all of them in every tool page's render-blocking bundle, and importing
// one from the tool's module does not help: Astro hoists the CSS of every
// module the page's script can import. `?url` hands back a hashed file without
// adding it to the page. Both links go in the head, tools-common.css first:
// a page-level import would be injected at the END of the head, after them.
const TOOL_CSS = import.meta.glob<string>('../../components/tools/*/*.css', { query: '?url', import: 'default', eager: true })
const toolCss = TOOL_CSS[`../../components/tools/${slug}/${slug}.css`]

// Tools that have moved elsewhere keep their old URL alive with a permanent
// redirect, so existing links and search results don't 404. Type Trial graduated
// from a tool to a game.
const MOVED: Record<string, string> = {
  'type-trial': '/games/type-trial',
  // Wallpaper Forge was renamed Driftfield when the six generative engines from
  // /games moved in alongside it. Both of its old names land on the new hub.
  'pattern-forge': '/tools/driftfield',
  'wallpaper-forge': '/tools/driftfield',
  // "MD Enhanced" named a file format, not a job. The tool is a writing desk, so
  // it is Draftboard now — but /tools/md-enhanced is live in production and
  // indexed, so the old URL keeps working.
  'md-enhanced': '/tools/draftboard',
}
const movedTo = MOVED[slug as string]
if (movedTo) return Astro.redirect(movedTo, 301)

const [site, tools, learnings] = await Promise.all([
  getSite(Astro.locals),
  getTools(Astro.locals),
  getLearnings(Astro.locals),
])
const tool = tools.find(t => t.slug === slug)

if (!tool || tool.status === 'external') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

if (tool.status === 'disabled') {
  const runtimeEnv = (Astro.locals as any).runtime?.env
  const token = getSessionToken(Astro.request)
  const isAdmin = (import.meta.env.DEV && !runtimeEnv?.ADMIN_SECRET && !process.env.ADMIN_SECRET)
    || await validateSession(token, runtimeEnv?.SITE_CONFIG)

  if (!isAdmin) {
    return new Response(null, { status: 404, statusText: 'Not Found' })
  }
}

const ldJson = webAppJsonLd({
  name: tool.title,
  description: tool.metaDescription || tool.description,
  url: `${site.url}/tools/${tool.slug}`,
  authorName: site.name,
  authorUrl: site.url,
  applicationCategory: 'DeveloperApplication',
  keywords: tool.keywords,
})

// Visible trail + matching BreadcrumbList: gives the page an explicit way back up
// to the hub and makes it eligible for a breadcrumb path in search results.
const { crumbs, json: breadcrumbLd } = buildBreadcrumbs([
  { label: 'home', path: '/' },
  { label: 'tools', path: '/tools' },
  { label: tool.title, path: `/tools/${tool.slug}` },
], site.url)
// Every tool's host element is `<slug>-tool`, holding the title and intro the
// component replaces on upgrade. The audio transcriber draws its own chrome and
// renders an empty host. A slug outside the set renders no host, as before.
const TOOL_SLUGS = new Set([
  'draftboard', 'audio-transcriber', 'wallpaper-forge', 'json-tidy', 'list-forge',
  'epoch-wizard', 'chroma-lab', 'codec-forge', 'hash-smith', 'cron-whisperer',
  'regex-lab', 'flowmap', 'token-bench', 'webhook-inspector', 'link-peek',
  'chainsaw', 'dns-sightline',
])
const NO_CHROME = new Set(['audio-transcriber'])
const ToolTag = TOOL_SLUGS.has(slug as string) ? `${slug}-tool` as any : undefined
const toolSeoContentHtml = tool.seoContent ? render(tool.seoContent) : ''
// The article about this tool, if one is published.
const stories = learningsAboutEmbed(tool.slug, learnings)
  .map(l => ({ title: l.title, href: `/learnings/${l.slug}` }))
// Cron Whisperer's preset pages: one crawlable link each from the tool's own page.
const cronPresetLinks = slug === CRON_WHISPERER_SLUG && isCronWhispererPublic(tools)
  ? CRON_PRESETS.map(p => ({ title: p.title, href: `/tools/${CRON_WHISPERER_SLUG}/${p.slug}` }))
  : []
// Card only when the generator emits one AND the PNG is really on disk — a
// forgotten `npm run og` must degrade to the avatar, not a 404ing og:image.
const ogCard = toolHasOgCard(tool) ? await existingOgCardPath('tools', tool.slug) : undefined
---

<ToolBase
  toolTitle={tool.title}
  seoTitle={tool.seoTitle}
  metaDescription={tool.metaDescription}
  keywords={tool.keywords}
  ogCard={ogCard}
  noindex={tool.status !== 'live'}
>
  <JsonLd json={ldJson} />
  <JsonLd json={breadcrumbLd} />
  <link slot="head" rel="stylesheet" href={toolsCommonCss} />
  {toolCss && <link slot="head" rel="stylesheet" href={toolCss} />}
  <Breadcrumbs items={crumbs} inset />
  {ToolTag && (
    <ToolTag data-tool={slug}>
      {!NO_CHROME.has(slug as string) && <h1>{tool.title}</h1>}
      {!NO_CHROME.has(slug as string) && <p>{tool.intro || tool.description}</p>}
    </ToolTag>
  )}
  {toolSeoContentHtml && <section data-type="seo-support" data-inset set:html={toolSeoContentHtml} />}
  <RelatedLinks heading="Common schedules" items={cronPresetLinks} inset />
  <RelatedLinks heading="Read about it" items={stories} inset />
</ToolBase>

<script>
  // Mount the tool's controller on initial load AND after every View Transition
  // navigation. Bundled scripts run only once per session, so without astro:page-load
  // a tool reached via in-site nav renders blank until a hard reload.
  function mountTool() {
    const slug = document.querySelector('[data-tool]')?.getAttribute('data-tool')
    if (slug === 'draftboard') import('../../components/tools/draftboard/Draftboard.ts')
    else if (slug === 'audio-transcriber') import('../../components/tools/audio-transcriber/AudioTranscriber.ts')
    else if (slug === 'wallpaper-forge') import('../../components/tools/wallpaper-forge/WallpaperForge.ts')
    else if (slug === 'json-tidy') import('../../components/tools/json-tidy/JsonTidy.ts')
    else if (slug === 'list-forge') import('../../components/tools/list-forge/ListForge.ts')
    else if (slug === 'epoch-wizard') import('../../components/tools/epoch-wizard/EpochWizard.ts')
    else if (slug === 'chroma-lab') import('../../components/tools/chroma-lab/ChromaLab.ts')
    else if (slug === 'codec-forge') import('../../components/tools/codec-forge/CodecForge.ts')
    else if (slug === 'hash-smith') import('../../components/tools/hash-smith/HashSmith.ts')
    else if (slug === 'cron-whisperer') import('../../components/tools/cron-whisperer/CronWhisperer.ts')
    else if (slug === 'regex-lab') import('../../components/tools/regex-lab/RegexLab.ts')
    else if (slug === 'webhook-inspector') import('../../components/tools/webhook-inspector/WebhookInspector.ts')
    else if (slug === 'link-peek') import('../../components/tools/link-peek/LinkPeek.ts')
    else if (slug === 'chainsaw') import('../../components/tools/chainsaw/Chainsaw.ts')
    else if (slug === 'dns-sightline') import('../../components/tools/dns-sightline/DnsSightline.ts')
    else if (slug === 'token-bench') import('../../components/tools/token-bench/TokenBench.ts')
    else if (slug === 'flowmap') import('../../components/tools/flowmap/Flowmap.ts')
  }
  document.addEventListener('astro:page-load', mountTool)
  mountTool()
</script>
