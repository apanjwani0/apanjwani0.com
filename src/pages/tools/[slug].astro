---
export const prerender = false

import ToolBase from '../../layouts/ToolBase.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { tools } from '../../config/tools'
import { getSite } from '../../lib/config'
import { breadcrumbListJsonLd, webAppJsonLd } from '../../lib/jsonld'
import { validateSession } from '../../lib/session'
import '../../components/tools/tools-common.css'
import '../../components/tools/md-enhanced/md-enhanced.css'
import '../../components/tools/audio-transcriber/audio-transcriber.css'
import '../../components/tools/pattern-forge/pattern-forge.css'
import '../../components/tools/json-tidy/json-tidy.css'
import '../../components/tools/list-forge/list-forge.css'
import '../../components/tools/epoch-wizard/epoch-wizard.css'
import '../../components/tools/chroma-lab/chroma-lab.css'
import '../../components/tools/codec-forge/codec-forge.css'
import '../../components/tools/hash-smith/hash-smith.css'

const { slug } = Astro.params

// Tools that have moved elsewhere keep their old URL alive with a permanent
// redirect, so existing links and search results don't 404. Type Trial graduated
// from a tool to a game.
const MOVED: Record<string, string> = { 'type-trial': '/games/type-trial' }
const movedTo = MOVED[slug as string]
if (movedTo) return Astro.redirect(movedTo, 301)

const tool = tools.find(t => t.slug === slug)

if (!tool || tool.status === 'external') {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

if (tool.status === 'disabled') {
  const runtimeEnv = (Astro.locals as any).runtime?.env
  const cookie = Astro.request.headers.get('cookie') ?? ''
  const token = cookie.match(/(?:^|;\s*)__admin_session=([^;]+)/)?.[1]
  const isAdmin = (import.meta.env.DEV && !runtimeEnv?.ADMIN_SECRET && !process.env.ADMIN_SECRET)
    || await validateSession(token, runtimeEnv?.SITE_CONFIG)

  if (!isAdmin) {
    return new Response(null, { status: 404, statusText: 'Not Found' })
  }
}

const site = await getSite(Astro.locals)
const ldJson = webAppJsonLd({
  name: tool.title,
  description: tool.metaDescription || tool.description,
  url: `${site.url}/tools/${tool.slug}`,
  authorName: site.name,
  authorUrl: site.url,
  applicationCategory: 'DeveloperApplication',
  keywords: tool.keywords,
})

// Visible trail + matching BreadcrumbList: gives the page an explicit way back up
// to the hub and makes it eligible for a breadcrumb path in search results.
const crumbs = [
  { label: 'home', href: '/' },
  { label: 'tools', href: '/tools' },
  { label: tool.title },
]
const breadcrumbLd = breadcrumbListJsonLd([
  { name: 'Home', url: site.url },
  { name: 'Tools', url: `${site.url}/tools` },
  { name: tool.title, url: `${site.url}/tools/${tool.slug}` },
])
---

<ToolBase
  toolTitle={tool.title}
  seoTitle={tool.seoTitle}
  metaDescription={tool.metaDescription}
  keywords={tool.keywords}
>
  <script type="application/ld+json" set:html={ldJson} />
  <script type="application/ld+json" set:html={breadcrumbLd} />
  <Breadcrumbs items={crumbs} inset />
  {slug === 'md-enhanced' && <md-enhanced-tool data-tool="md-enhanced"></md-enhanced-tool>}
  {slug === 'audio-transcriber' && <audio-transcriber-tool data-tool="audio-transcriber"></audio-transcriber-tool>}
  {slug === 'pattern-forge' && <pattern-forge-tool data-tool="pattern-forge"></pattern-forge-tool>}
  {slug === 'json-tidy' && (
    <json-tidy-tool data-tool="json-tidy">
      <h1>{tool.title}</h1>
      <p>{tool.intro || tool.description}</p>
    </json-tidy-tool>
  )}
  {slug === 'list-forge' && (
    <list-forge-tool data-tool="list-forge">
      <h1>{tool.title}</h1>
      <p>{tool.intro || tool.description}</p>
    </list-forge-tool>
  )}
  {slug === 'epoch-wizard' && (
    <epoch-wizard-tool data-tool="epoch-wizard">
      <h1>{tool.title}</h1>
      <p>{tool.intro || tool.description}</p>
    </epoch-wizard-tool>
  )}
  {slug === 'chroma-lab' && (
    <chroma-lab-tool data-tool="chroma-lab">
      <h1>{tool.title}</h1>
      <p>{tool.intro || tool.description}</p>
    </chroma-lab-tool>
  )}
  {slug === 'codec-forge' && (
    <codec-forge-tool data-tool="codec-forge">
      <h1>{tool.title}</h1>
      <p>{tool.intro || tool.description}</p>
    </codec-forge-tool>
  )}
  {slug === 'hash-smith' && (
    <hash-smith-tool data-tool="hash-smith">
      <h1>{tool.title}</h1>
      <p>{tool.intro || tool.description}</p>
    </hash-smith-tool>
  )}
</ToolBase>

<script>
  // Mount the tool's controller on initial load AND after every View Transition
  // navigation. Bundled scripts run only once per session, so without astro:page-load
  // a tool reached via in-site nav renders blank until a hard reload.
  function mountTool() {
    const slug = document.querySelector('[data-tool]')?.getAttribute('data-tool')
    if (slug === 'md-enhanced') import('../../components/tools/md-enhanced/MdEnhanced.ts')
    else if (slug === 'audio-transcriber') import('../../components/tools/audio-transcriber/AudioTranscriber.ts')
    else if (slug === 'pattern-forge') import('../../components/tools/pattern-forge/PatternForge.ts')
    else if (slug === 'json-tidy') import('../../components/tools/json-tidy/JsonTidy.ts')
    else if (slug === 'list-forge') import('../../components/tools/list-forge/ListForge.ts')
    else if (slug === 'epoch-wizard') import('../../components/tools/epoch-wizard/EpochWizard.ts')
    else if (slug === 'chroma-lab') import('../../components/tools/chroma-lab/ChromaLab.ts')
    else if (slug === 'codec-forge') import('../../components/tools/codec-forge/CodecForge.ts')
    else if (slug === 'hash-smith') import('../../components/tools/hash-smith/HashSmith.ts')
  }
  document.addEventListener('astro:page-load', mountTool)
</script>
