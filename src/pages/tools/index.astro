---
export const prerender = true

import Base from '../../layouts/Base.astro'
import { tools } from '../../config/tools'
import '../../styles/tools.css'
---

<Base
  title="tools"
  description="Free, browser-based tools built by Aman Panjwani — no sign-up, no tracking, just open and use."
>
  <h1>tools</h1>
  <p data-type="page-intro">
    Small, fast, single-purpose tools I built to scratch my own itches. Each one is
    copy-first, keyboard-friendly, and runs entirely in your browser — no sign-ups,
    no tracking, nothing uploaded.
  </p>
  <ul data-type="preview-list">
    {tools.filter(t => t.status !== 'disabled').map(tool => (
      <li data-status={tool.status}>
        {tool.status === 'wip'
          ? <span data-type="tool-name">{tool.title}</span>
          : <a
              href={tool.status === 'external' ? tool.href! : `/tools/${tool.slug}`}
              {...(tool.status === 'external' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >{tool.title}</a>
        }
        {' — '}
        <span data-type="tool-description">{tool.description}</span>
        {tool.status === 'wip' && <span data-type="tool-wip"> · coming soon</span>}
      </li>
    ))}
  </ul>
</Base>
