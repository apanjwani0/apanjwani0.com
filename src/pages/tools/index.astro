---
export const prerender = true

import Base from '../../layouts/Base.astro'
import { site } from '../../config/site'
import { tools } from '../../config/tools'
import { itemListJsonLd } from '../../lib/jsonld'
import '../../styles/tools.css'

// Prerendered page: KV isn't available at build time, so read the static config
// directly (same reason `tools` is imported statically, not via getTools()).

// Map the navigable tools (live pages + external links; skip wip placeholders and
// disabled tools) to an ItemList so search engines get an explicit, ordered map of
// the hub — the listing-page counterpart to each tool's WebApplication schema.
const listed = tools.filter(t => t.status === 'live' || t.status === 'external')
const ldJson = itemListJsonLd(
  'Tools by Aman Panjwani',
  listed.map(t => ({
    name: t.title,
    url: t.status === 'external' ? t.href! : `${site.url}/tools/${t.slug}`,
  })),
)
---

<Base
  wide
  title="tools"
  description="Free browser tools — JSON repair, list and timestamp converters, colour and contrast checks, Base64/URL encoding, hashes and UUIDs, a cron expression explainer, a live regex tester, a seeded wallpaper and looping GIF maker, and a live markdown editor. No sign-up, nothing uploaded."
  keywords="developer tools, online dev tools, json formatter, json repair, fix json, json fixer, json viewer, column to comma separated list, comma separator, list to csv converter, unix timestamp converter, epoch converter, color converter, wcag contrast checker, contrast ratio, base64 encoder, base64 decoder, url encoder, url decoder, query string parser, sha256 hash generator, hmac generator, checksum verifier, uuid generator, guid generator, cron expression explainer, crontab explainer, cron to english, cron next run, regex tester, regular expression tester, regex replace, regex online, wallpaper generator, gif generator, pattern generator, generative art maker, markdown editor, browser tools, free online tools, no-login tools"
>
  {listed.length > 0 && <script type="application/ld+json" set:html={ldJson} />}
  <h1>tools</h1>
  <p data-type="page-intro">
    Small, fast, single-purpose tools I built to scratch my own itches — a JSON
    formatter, repairer, and tree viewer, a list converter, a Unix timestamp
    converter, a colour converter and contrast checker, a Base64 and URL
    encoder/decoder, a SHA/HMAC hash and UUID generator, a cron expression
    explainer, a live regex tester, a seeded wallpaper and looping GIF maker,
    and a markdown editor.
    Each one is copy-first, keyboard-friendly, and runs
    entirely in your browser: no sign-ups, no tracking, nothing uploaded.
  </p>
  <ul data-type="card-grid">
    {tools.filter(t => t.status !== 'disabled').map(tool => (
      <li data-status={tool.status}>
        <div data-type="tool-head">
          <h2 data-type="tool-name">
            {tool.status === 'wip'
              ? tool.title
              : <a
                  href={tool.status === 'external' ? tool.href! : `/tools/${tool.slug}`}
                  {...(tool.status === 'external' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >{tool.title}</a>
            }
          </h2>
          {tool.status === 'wip' && <span data-type="tool-wip">coming soon</span>}
          {tool.status === 'external' && <span data-type="tool-wip">external ↗</span>}
        </div>
        <span data-type="tool-description">{tool.description}</span>
      </li>
    ))}
  </ul>
</Base>
