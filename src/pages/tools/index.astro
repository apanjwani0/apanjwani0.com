---
export const prerender = false

import Base from '../../layouts/Base.astro'
import Card from '../../components/Card.astro'
import JsonLd from '../../components/JsonLd.astro'
import { getSite, getTools } from '../../lib/config'
import { collectionPageJsonLd } from '../../lib/jsonld'
import { existingOgHubCardPath } from '../../lib/og'
import { safeExternalUrl } from '../../lib/security'
import { shellLinkAttrs } from '../../lib/shells'
import { isServerTool, TOOL_GROUPS, UNGROUPED_TITLE } from '../../lib/tools'
import { toolTries } from '../../lib/tool-tries'
import '../../styles/tools.css'

const [site, tools, ogCard] = await Promise.all([getSite(Astro.locals), getTools(Astro.locals), existingOgHubCardPath('tools')])

// Kept under ~155 characters deliberately. A search snippet is truncated past
// roughly that, so everything after it is text no searcher ever reads while
// every crawler still downloads it. The intro does not enumerate the shelf (the
// owner read the long version and called it too much text); the section
// headings and the cards carry the per-tool relevance.
// It lives here rather than inline because a JSX comment between two component
// attributes is unparseable to `astro check` while building green (see docs/operations.md).
const metaDescription =
  'Free developer tools, no sign-up: a live webhook tester, an SSL chain checker, ' +
  'a multi-resolver DNS checker, a JWT verifier, regex, JSON and cron tools.'

// The tools a visitor can open (live pages and external links), shown in the
// hub's sections; wip placeholders show as cards without a link, disabled ones
// not at all. A tool no section names lands in a closing section, so it can
// never vanish from the hub.
const shown = tools.filter(t => t.status !== 'disabled')
const bySlug = new Map(shown.map(t => [t.slug, t]))
const grouped = new Set(TOOL_GROUPS.flatMap(g => g.slugs))
const sections = [
  ...TOOL_GROUPS.map(g => ({ id: g.id, title: g.title, lede: g.lede, tools: g.slugs.flatMap(s => bySlug.get(s) ?? []) })),
  { id: 'more-tools', title: UNGROUPED_TITLE, lede: '', tools: shown.filter(t => !grouped.has(t.slug)) },
].filter(s => s.tools.length > 0)

const hrefOf = (tool: (typeof tools)[number]) =>
  tool.status === 'external' ? safeExternalUrl(tool.href) : `/tools/${tool.slug}`
const tries = toolTries()

// The hub as a CollectionPage over the same order the sections show, so the
// structured list and the visible one agree. Navigable tools only.
const listed = sections.flatMap(s => s.tools).filter(t => t.status === 'live' || t.status === 'external')
const ldJson = collectionPageJsonLd({
  name: `Tools by ${site.name}`,
  description: metaDescription,
  url: `${site.url}/tools`,
  items: listed.flatMap(t => {
    const url = t.status === 'external' ? safeExternalUrl(t.href) : `${site.url}/tools/${t.slug}`
    return url ? [{ name: t.title, url, description: t.description }] : []
  }),
})
---

<Base
  wide
  starfield={false}
  sky
  title="tools"
  seoTitle="Free Online Dev Tools — Webhook Tester & SSL Chain Checker"
  description={metaDescription}
  ogCard={ogCard}
  keywords="developer tools, webhook tester, ssl certificate checker, dns checker, jwt verifier, cron expression explainer, mind map maker, json formatter, regex tester, free online tools"
>
  {listed.length > 0 && <JsonLd json={ldJson} />}
  <h1>tools for developers and makers</h1>
  <p data-type="page-intro">
    Free to use, with no sign-ups and no tracking. Most of these run entirely
    in your browser; four need a real server, and they come first.
  </p>
  {sections.map(section => (
    <section data-type="tool-group" aria-labelledby={`group-${section.id}`}>
      <h2 id={`group-${section.id}`} data-type="group-title">{section.title}</h2>
      {section.lede && <p data-type="group-lede">{section.lede}</p>}
      <ul data-type="card-grid">
        {section.tools.map(tool => {
          const href = tool.status === 'wip' ? undefined : hrefOf(tool)
          const tryLink = tool.status === 'live' ? tries[tool.slug] : undefined
          return (
            <Card
              title={tool.title}
              href={href}
              external={tool.status === 'external'}
              status={tool.status}
              descAs="p"
              level={3}
            >
              <Fragment slot="badges">
                {tool.status === 'wip' && <span data-type="tool-wip">coming soon</span>}
                {/* The arrow is decorative — without aria-hidden a screen reader
                    announces "external north east arrow". */}
                {tool.status === 'external' && <span data-type="tool-wip">external <span aria-hidden="true">↗</span></span>}
                {/* Derived from src/lib/tools.ts, not from a config field the
                    admin middleware would regenerate away. */}
                {tool.status === 'live' && isServerTool(tool.slug) && <span data-type="tool-server">server</span>}
              </Fragment>
              <Fragment slot="desc">{tool.description}</Fragment>
              {/* A second link inside the card, raised above the stretched
                  title link by shared.css; it opens the tool with a real input
                  filled in (src/lib/tool-tries.ts). */}
              {tryLink && (
                <Fragment slot="meta">
                  try: <a href={tryLink.href} {...shellLinkAttrs(tryLink.href)} aria-label={`Open ${tool.title} with ${tryLink.label} filled in`}>{tryLink.label}</a>
                </Fragment>
              )}
            </Card>
          )
        })}
      </ul>
    </section>
  ))}
</Base>
