---
export const prerender = false

import Base from '../layouts/Base.astro'
import Card from '../components/Card.astro'
import JsonLd from '../components/JsonLd.astro'
import { getSite, getLearnings } from '../lib/config'
import { itemListJsonLd } from '../lib/jsonld'
import { isPublishedLearning, readingTime } from '../lib/learnings'
import { render } from '../lib/markdown'
import { formatDisplayDate } from '../lib/date'

const [site, learnings] = await Promise.all([getSite(Astro.locals), getLearnings(Astro.locals)])

// Published only, newest first. Sort a copy — the accessor's array is shared, and
// mutating it would reorder every other consumer in the same request. String
// compare is correct for YYYY-MM-DD and the sort is stable for same-day entries.
// The visible list and the ItemList below read the same array, so they agree.
const ordered = learnings
  .filter(isPublishedLearning)
  .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0))

const ldJson = itemListJsonLd(
  `Learnings by ${site.name}`,
  ordered.map(l => ({ name: l.title, url: `${site.url}/learnings/${l.slug}` })),
)
---

<Base
  wide
  starfield={false}
  sky
  title="learnings"
  description="Short, visual explainers of how things work, with interactive diagrams you can play with while you read."
  keywords="interactive explainers, how things work, visual explanations, how the internet works, system diagrams"
>
  {ordered.length > 0 && <JsonLd json={ldJson} />}
  <h1>learnings</h1>
  <p data-type="page-intro">
    Short, visual explainers of how things work. Each one has diagrams you can
    play with while you read.
  </p>
  {ordered.length === 0 && <p>Nothing published yet — the first pieces are being written.</p>}
  <ul data-type="card-grid">
    {ordered.map(l => (
      <Card title={l.title} href={`/learnings/${l.slug}`}>
        <Fragment slot="desc" set:html={render(l.summary)} />
        <span slot="meta" data-type="writing-date"><time datetime={l.date}>{formatDisplayDate(l.date)}</time> · {readingTime(l.content)} min read</span>
      </Card>
    ))}
  </ul>
</Base>
