---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite, getPosts, isBlogsPublic } from '../lib/config'
import { itemListJsonLd } from '../lib/jsonld'
import { render } from '../lib/markdown'
import { formatDisplayDate } from '../lib/date'
import { safeExternalUrl, safeInternalPath } from '../lib/security'

const [site, posts] = await Promise.all([getSite(Astro.locals), getPosts(Astro.locals)])
// Hidden section: the route still answers so existing links keep working, but it
// tells crawlers not to index it. Same flag the nav and the sitemap read.
const noindex = !isBlogsPublic(site)
const cspNonce = (Astro.locals as any).cspNonce

// Show the newest writing first. Sort a copy (never mutate the accessor's array,
// which is cached/shared) by the authored ISO date descending — string compare is
// correct for YYYY-MM-DD, and the modern sort is stable for same-day posts. The
// visible list and the ItemList below both read from this order so they match.
const orderedPosts = [...posts].sort((a, b) =>
  a.date < b.date ? 1 : a.date > b.date ? -1 : 0,
)

const formatHref = (href: string) => {
  const external = safeExternalUrl(href)
  if (external) return external
  const internal = safeInternalPath(href)
  if (internal) return internal
  if (/^[a-z0-9][a-z0-9-]*(\/[a-z0-9][a-z0-9-]*)?$/i.test(href)) {
    if (href.startsWith('blogs/')) return '/' + href
    return '/blogs/' + href
  }
  return '/blogs'
}

// Structured item map for the listing, matching /tools and /games.
const ldJson = itemListJsonLd(
  'Writing by Aman Panjwani',
  // new URL() resolves a root-relative href against the site origin and leaves an
  // already-absolute (external, cross-posted) href untouched — string concat would
  // double-prefix the latter into `https://site.com/https://…`.
  orderedPosts.map(p => ({ name: p.title, url: new URL(formatHref(p.href), site.url).href })),
)
---

<Base
  wide
  noindex={noindex}
  title="blogs"
  description="Writing by Aman Panjwani on software engineering, payments, and side projects."
  keywords="aman panjwani blog, engineering notes, payments engineering, build notes, side project writing"
>
  {!noindex && posts.length > 0 && <script nonce={cspNonce} type="application/ld+json" set:html={ldJson} />}
  <h1>blogs</h1>
  <p data-type="page-intro">
    Occasional notes on engineering, payments, and whatever I'm currently nerding out about.
  </p>
  <ul data-type="card-grid">
    {orderedPosts.map(p => {
      // A cross-posted entry points off-site; open it in a new tab with a hardened
      // rel and an accessible "opens in a new tab" hint, matching the affordance
      // used on the home hero and project cards. Internal posts stay in-tab.
      const external = Boolean(safeExternalUrl(p.href))
      return (
        <li>
          <div data-type="writing-row">
            <time data-type="writing-date" datetime={p.date}>{formatDisplayDate(p.date)}</time>
            <h2 data-type="card-title">
              <a
                href={formatHref(p.href)}
                {...(external
                  ? { target: '_blank', rel: 'noopener noreferrer', 'aria-label': `${p.title} (opens in a new tab)` }
                  : {})}
              >{p.title}</a>
            </h2>
          </div>
          <div data-type="writing-summary" set:html={render(p.summary)} />
        </li>
      )
    })}
  </ul>
</Base>
