---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite, getPosts } from '../lib/config'
import { itemListJsonLd } from '../lib/jsonld'
import { render } from '../lib/markdown'

const [site, posts] = await Promise.all([getSite(Astro.locals), getPosts(Astro.locals)])

const formatHref = (href: string) => {
  if (href.startsWith('http') || href.startsWith('/')) return href
  if (href.startsWith('blogs/')) return '/' + href
  return '/blogs/' + href
}

// Structured item map for the listing, matching /tools and /games.
const ldJson = itemListJsonLd(
  'Writing by Aman Panjwani',
  // new URL() resolves a root-relative href against the site origin and leaves an
  // already-absolute (external, cross-posted) href untouched — string concat would
  // double-prefix the latter into `https://site.com/https://…`.
  posts.map(p => ({ name: p.title, url: new URL(formatHref(p.href), site.url).href })),
)
---

<Base
  wide
  title="blogs"
  description="Writing by Aman Panjwani on software engineering, payments, and side projects."
  keywords="aman panjwani blog, engineering notes, payments engineering, build notes, side project writing"
>
  {posts.length > 0 && <script type="application/ld+json" set:html={ldJson} />}
  <h1>blogs</h1>
  <p data-type="page-intro">
    Occasional notes on engineering, payments, and whatever I'm currently nerding out about.
  </p>
  <ul data-type="card-grid">
    {posts.map(p => (
      <li>
        <div data-type="writing-row">
          <time data-type="writing-date" datetime={p.date}>{p.date}</time>
          <a href={formatHref(p.href)}>{p.title}</a>
        </div>
        <div data-type="writing-summary" set:html={render(p.summary)} />
      </li>
    ))}
  </ul>
</Base>
