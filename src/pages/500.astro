---
export const prerender = false

import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { getSite, navLinks } from '../lib/config'
import '../styles/error-page.css'

// Astro renders this page for a route that threw. Without it, the path /500
// fell through to [slug].astro, whose bodyless 404 was cached at the edge as a
// blank page. The error itself is never shown: an exception's message never
// reaches a response. The middleware sends no-store for any 5xx.
//
// The links are the 404's pattern: derived from navLinks(), so this page can
// never advertise a section the nav and footer hide. "Try again" points at the
// path that was asked for (a path is never an exception message), and reloads
// the page for real instead of asking the client router to navigate.
const site = await getSite(Astro.locals)
const links = navLinks(site)
const retryHref = Astro.url.pathname
---

<Base title="500" description="Something went wrong on this site's side." noindex>
  <Breadcrumbs items={[{ label: 'home', href: '/' }, { label: 'error' }]} />
  <section data-type="error-page" aria-labelledby="err-title">
    <p data-type="error-code">500</p>
    <h1 id="err-title">Something went wrong on this site's side.</h1>
    <p data-type="error-lead">
      The page could not be built just now. Nothing you did caused it. Try the
      same page again in a moment, or land somewhere else.
    </p>
    <div data-type="error-actions">
      <a href={retryHref} data-astro-reload data-type="error-retry">try again</a>
      <a href="/">home</a>
    </div>
    <nav data-type="error-links" aria-label="Suggested pages">
      {links.map(l => <a href={l.href}>{l.label}</a>)}
    </nav>
    <p data-type="error-help">
      If it keeps happening, every section is linked in the footer at the
      bottom of this page, and the home page is always a safe place to start.
    </p>
  </section>
</Base>
