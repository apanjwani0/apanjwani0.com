---
export const prerender = false

import Base from '../layouts/Base.astro'
import Avatar from '../components/Avatar.astro'
import { getSite } from '../lib/config'
import { personJsonLd, webSiteJsonLd } from '../lib/jsonld'
import { safeExternalUrl } from '../lib/security'
import '../styles/home.css'

const site = await getSite(Astro.locals)
const cspNonce = (Astro.locals as any).cspNonce

// Bespoke hero line for the landing page. site.tagline stays the role line used
// for SEO/meta and the rest of the site.
const heroTagline =
  'I build software for a living and for fun — payments at scale by day; apps, tools and games by night.'
// The home page has no page title, so without this it would fall back to the bare
// role line (`site.tagline`) as its meta/OG/Twitter description — a thin snippet
// for the most-linked page. This describes what the site actually offers.
const homeDescription =
  `${site.name} builds payments infrastructure by day, and apps, tools and games by night — explore free, browser-based developer tools and playable experiments.`

const githubUrl = safeExternalUrl(site.social.github)
const linkedinUrl = safeExternalUrl(site.social.linkedin)
const sameAs = [githubUrl, linkedinUrl].filter((url): url is string => Boolean(url))
const ldJson = personJsonLd({
  name: site.name,
  url: site.url,
  jobTitle: site.tagline,
  description: site.bio,
  sameAs,
  image: `${site.url}/avatar.webp`,
})

// Site-level entity for the home page: pairs with the Person schema so search
// engines understand this as one named site authored by Aman.
const siteLd = webSiteJsonLd({
  name: site.name,
  url: site.url,
  description: site.bio,
  authorName: site.name,
  authorUrl: site.url,
})
---

<Base bare description={homeDescription} keywords={`${site.name}, ${site.handle}, portfolio, software engineer, developer tools, browser games`}>
  <script nonce={cspNonce} type="application/ld+json" set:html={ldJson} />
  <script nonce={cspNonce} type="application/ld+json" set:html={siteLd} />

  <section data-type="hero" aria-label="Introduction">
    <div data-type="hero-content">
      <Avatar src={site.avatar} alt={`Portrait of ${site.name}`} />
      <h1>{site.name}</h1>
      <p data-type="tagline">{heroTagline}</p>
      <nav data-type="hero-links" aria-label="Social profiles">
        {githubUrl && <a href={githubUrl} target="_blank" rel="me noopener noreferrer">github</a>}
        {linkedinUrl && <a href={linkedinUrl} target="_blank" rel="me noopener noreferrer">linkedin</a>}
      </nav>
    </div>
  </section>
</Base>
