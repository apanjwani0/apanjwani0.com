---
export const prerender = false

import Base from '../layouts/Base.astro'
import Avatar from '../components/Avatar.astro'
import { getSite } from '../lib/config'
import { personJsonLd } from '../lib/jsonld'
import '../styles/home.css'

const site = await getSite(Astro.locals)

// Bespoke hero line for the landing page. site.tagline stays the role line used
// for SEO/meta and the rest of the site.
const heroTagline =
  'I build software for a living and for fun — payments at scale by day; apps, tools and games by night.'

const sameAs = [site.social.github, site.social.linkedin].filter(Boolean)
const ldJson = personJsonLd({
  name: site.name,
  url: site.url,
  jobTitle: site.tagline,
  description: site.bio,
  sameAs,
  image: `${site.url}/avatar.webp`,
})
---

<Base bare keywords={`${site.name}, ${site.handle}, portfolio, software engineer`}>
  <script type="application/ld+json" set:html={ldJson} />

  <nav data-type="hero-nav" aria-label="Site sections">
    {site.nav.flatMap((item) => ('children' in item ? item.children : [item])).map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>

  <star-field data-type="starfield" aria-hidden="true"></star-field>

  <section data-type="hero" aria-label="Introduction">
    <div data-type="hero-content">
      <Avatar src={site.avatar} alt={site.name} />
      <h1>{site.name}</h1>
      <p data-type="tagline">{heroTagline}</p>
      <nav data-type="hero-links" aria-label="Links">
        <a href={site.social.github} target="_blank" rel="noopener noreferrer">github</a>
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a>
        <a href="/experience">work</a>
      </nav>
    </div>
  </section>
</Base>

<script>
  // Load the canvas controller on initial load and after every View Transition
  // navigation — bundled scripts run only once per session otherwise, so the
  // hero canvas would be missing when home is reached via in-site nav.
  document.addEventListener('astro:page-load', () => {
    import('../components/home/StarField.ts')
  })
</script>
