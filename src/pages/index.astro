---
export const prerender = false

import Base from '../layouts/Base.astro'
import Avatar from '../components/Avatar.astro'
import { getProjects, getSite } from '../lib/config'
import { personJsonLd, webSiteJsonLd } from '../lib/jsonld'
import { safeExternalUrl } from '../lib/security'
import '../styles/home.css'
import '../styles/hero-liquid.css'
import '../styles/hero-network.css'
import '../styles/hero-monsoon.css'

const site = await getSite(Astro.locals)
const cspNonce = (Astro.locals as any).cspNonce

// Bespoke hero line for the landing page. site.tagline stays the role line used
// for SEO/meta and the rest of the site. The owner asked for no tools or games
// anywhere in the hero (2026-09-27), so the line names neither; the meta
// description below still does, because search is where that list helps.
const heroTagline =
  'I build software for a living and for fun: payments at scale by day, my own apps by night.'

// Which hero renders. Production always renders the classic one. The dev
// server also takes ?hero=liquid|network|classic, so the owner can compare the
// two candidates on the real page before picking one. `import.meta.env.DEV`
// is a build-time constant, so a production build never reads the query.
const HEROES = ['classic', 'liquid', 'network', 'monsoon'] as const
type Hero = (typeof HEROES)[number]
const requestedHero = import.meta.env.DEV ? Astro.url.searchParams.get('hero') : null
const hero: Hero = HEROES.find(h => h === requestedHero) ?? 'classic'
const liveHero = hero === 'classic' ? undefined : hero
// The home page has no page title, so without this it would fall back to the bare
// role line (`site.tagline`) as its meta/OG/Twitter description — a thin snippet
// for the most-linked page. This describes what the site actually offers.
const homeDescription =
  `${site.name} builds payments infrastructure by day, and apps, tools and games by night — explore free, browser-based developer tools and playable experiments.`

const githubUrl = safeExternalUrl(site.social.github)
const linkedinUrl = safeExternalUrl(site.social.linkedin)
const sameAs = [githubUrl, linkedinUrl].filter((url): url is string => Boolean(url))
const ldJson = personJsonLd({
  name: site.name,
  url: site.url,
  jobTitle: site.tagline,
  description: site.bio,
  sameAs,
  image: `${site.url}/avatar.webp`,
})

// Site-level entity for the home page: pairs with the Person schema so search
// engines understand this as one named site authored by Aman.
const siteLd = webSiteJsonLd({
  name: site.name,
  url: site.url,
  description: site.bio,
  authorName: site.name,
  authorUrl: site.url,
})

// The monsoon hero's story chapters (see AGENTS.md "Home hero candidates").
// Kept tools/games-free the same blunt way the hero's own copy is: no project
// whose url or text so much as mentions either word makes the night chapter.
const TOOLS_GAMES_WORD = /\b(tools?|games?)\b/i
function firstSentence(text: string): string {
  const stripped = text.replace(/\*\*/g, '')
  const m = /^[^.!?]*[.!?]/.exec(stripped.trim())
  return (m ? m[0] : stripped).trim()
}
const nightProjects = hero === 'monsoon'
  ? (await getProjects(Astro.locals)).filter(p =>
      !p.url.includes('/tools') && !p.url.includes('/games') &&
      !TOOLS_GAMES_WORD.test(p.title) && !TOOLS_GAMES_WORD.test(p.description),
    )
  : []
const bioFirstSentence = firstSentence(site.bio)
---

<Base bare starfield={!liveHero} description={homeDescription} keywords={`${site.name}, ${site.handle}, portfolio, software engineer, developer tools, browser games`}>
  <script nonce={cspNonce} type="application/ld+json" set:html={ldJson} />
  <script nonce={cspNonce} type="application/ld+json" set:html={siteLd} />

  {/* A live hero draws on a canvas that is dark at every hour, so it pins the
      dark palette for its own subtree whatever theme the visitor stored. */}
  <section data-type="hero" aria-label="Introduction" data-hero={liveHero} data-theme={liveHero && 'dark'} data-at={hero === 'monsoon' ? '1420' : undefined}>
    {liveHero && <div data-type="hero-stage"></div>}
    <div data-type="hero-content">
      {!liveHero && <Avatar src={site.avatar} alt={`Portrait of ${site.name}`} />}
      <h1>{site.name}</h1>
      <p data-type="tagline">{heroTagline}</p>
      <nav data-type="hero-links" aria-label="Social profiles">
        {githubUrl && <a href={githubUrl} target="_blank" rel="me noopener noreferrer" aria-label={`${site.name} on GitHub (opens in a new tab)`}>github</a>}
        {linkedinUrl && <a href={linkedinUrl} target="_blank" rel="me noopener noreferrer" aria-label={`${site.name} on LinkedIn (opens in a new tab)`}>linkedin</a>}
      </nav>
    </div>
    {hero === 'monsoon' && (
      <>
        <p data-type="monsoon-hint" hidden>psst… strike a match</p>
        <p data-type="monsoon-hud" aria-hidden="true"></p>
        <p data-type="monsoon-live" aria-live="polite" data-visually-hidden></p>
        <p data-type="monsoon-cue" aria-hidden="true">scroll ↓</p>
      </>
    )}
  </section>

  {hero === 'monsoon' && (
    <div data-type="story" data-theme="dark">
      <section data-chapter="night" data-at="95" aria-labelledby="chapter-night-title">
        <p data-type="kicker">night shift</p>
        <h2 id="chapter-night-title">My own apps, after hours.</h2>
        {nightProjects.length > 0 && (
          <ul>
            {nightProjects.map(p => {
              const url = safeExternalUrl(p.url)
              return url && (
                <li>
                  <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`${p.title} (opens in a new tab)`}>{p.title}</a>
                  <p>{firstSentence(p.description)}</p>
                </li>
              )
            })}
          </ul>
        )}
        <a href="/projects">all projects →</a>
      </section>
      <section data-chapter="day" data-at="660" aria-labelledby="chapter-day-title">
        <p data-type="kicker">day shift</p>
        <h2 id="chapter-day-title">Payments at scale.</h2>
        <p>{bioFirstSentence}</p>
        <p data-type="mono-line">{site.tagline}</p>
      </section>
      <section data-chapter="dusk" data-at="1180" aria-labelledby="chapter-dusk-title">
        <p data-type="kicker">off the clock</p>
        <h2 id="chapter-dusk-title">Say hi.</h2>
        <nav aria-label="Social profiles">
          {githubUrl && <a href={githubUrl} target="_blank" rel="me noopener noreferrer" aria-label={`${site.name} on GitHub (opens in a new tab)`}>github</a>}
          {linkedinUrl && <a href={linkedinUrl} target="_blank" rel="me noopener noreferrer" aria-label={`${site.name} on LinkedIn (opens in a new tab)`}>linkedin</a>}
        </nav>
        <a href="/learnings">learnings →</a>
      </section>
      <div data-type="story-loop" aria-hidden="true" inert>
        <div data-type="hero-content">
          <p data-type="loop-name">{site.name}</p>
          <p data-type="tagline">{heroTagline}</p>
          <nav data-type="hero-links" aria-label="Social profiles">
            {githubUrl && <a href={githubUrl} target="_blank" rel="me noopener noreferrer">github</a>}
            {linkedinUrl && <a href={linkedinUrl} target="_blank" rel="me noopener noreferrer">linkedin</a>}
          </nav>
        </div>
        <p data-type="monsoon-cue">scroll ↓</p>
      </div>
    </div>
  )}

  {import.meta.env.DEV && (
    <nav data-type="hero-switch" aria-label="Hero preview (dev server only)">
      <span>hero</span>
      {HEROES.map(h => (
        <a href={`/?hero=${h}`} aria-current={h === hero ? 'page' : undefined}>{h}</a>
      ))}
    </nav>
  )}

  {liveHero && (
    <script>
      import { initHero } from '../components/home/hero/mount'
      initHero()
    </script>
  )}
</Base>
