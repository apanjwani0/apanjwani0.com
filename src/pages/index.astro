---
export const prerender = false

import Base from '../layouts/Base.astro'
import JsonLd from '../components/JsonLd.astro'
import { getSite } from '../lib/config'
import { personJsonLd, webSiteJsonLd } from '../lib/jsonld'
import { safeExternalUrl } from '../lib/security'
import '../styles/home.css'
import '../styles/hero-network.css'

const site = await getSite(Astro.locals)

// Bespoke hero line for the landing page. site.tagline stays the role line used
// for SEO/meta and the rest of the site. The owner asked for no tools or games
// anywhere in the hero (2026-09-27), so the line names neither; the meta
// description below still does, because search is where that list helps.
const heroTagline =
  'I build payment systems for a living, and my own apps for fun.'

// The home page has no page title, so without this it would fall back to the bare
// role line (`site.tagline`) as its meta/OG/Twitter description — a thin snippet
// for the most-linked page. This describes what the site actually offers.
const homeDescription =
  `${site.name} builds payments infrastructure by day, and apps, tools and games by night — explore free, browser-based developer tools and playable experiments.`

const githubUrl = safeExternalUrl(site.social.github)
const linkedinUrl = safeExternalUrl(site.social.linkedin)
const sameAs = [githubUrl, linkedinUrl].filter((url): url is string => Boolean(url))
const ldJson = personJsonLd({
  name: site.name,
  url: site.url,
  jobTitle: site.tagline,
  description: site.bio,
  sameAs,
  image: `${site.url}/avatar.webp`,
})

// Site-level entity for the home page: pairs with the Person schema so search
// engines understand this as one named site authored by Aman.
const siteLd = webSiteJsonLd({
  name: site.name,
  url: site.url,
  description: site.bio,
  authorName: site.name,
  authorUrl: site.url,
})
---

<Base bare starfield={false} description={homeDescription} keywords={`${site.name}, ${site.handle}, portfolio, software engineer, developer tools, browser games`}>
  <JsonLd json={ldJson} />
  <JsonLd json={siteLd} />

  {/* The hero replays this page load on a canvas that is dark at every hour,
      so it pins the dark palette for its own subtree whatever theme the
      visitor stored, and draws its own stars instead of the StarField. */}
  <section data-type="hero" aria-label="Introduction" data-hero="network" data-theme="dark">
    <div data-type="hero-stage"></div>
    <div data-type="hero-content">
      <h1>{site.name}</h1>
      <p data-type="tagline">{heroTagline}</p>
      <nav data-type="hero-links" aria-label="Social profiles">
        {githubUrl && <a href={githubUrl} target="_blank" rel="me noopener noreferrer" aria-label={`${site.name} on GitHub (opens in a new tab)`}>github</a>}
        {linkedinUrl && <a href={linkedinUrl} target="_blank" rel="me noopener noreferrer" aria-label={`${site.name} on LinkedIn (opens in a new tab)`}>linkedin</a>}
      </nav>
    </div>
  </section>

  <script>
    import { initHero } from '../components/home/hero/mount'
    initHero()
  </script>
</Base>
