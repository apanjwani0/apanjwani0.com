---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite } from '../lib/config'
import { personJsonLd } from '../lib/jsonld'
import '../styles/home.css'

const site = await getSite(Astro.locals)

// Bespoke hero line for the landing page, reused as the home page's meta
// description (the default site.tagline role line is too thin a search snippet
// for the most important page). site.tagline stays the role line elsewhere.
const heroTagline =
  'I build software for a living and for fun — payments at scale by day; apps, tools and games by night.'

const sameAs = [site.social.github, site.social.linkedin].filter(Boolean)
const ldJson = personJsonLd({
  name: site.name,
  url: site.url,
  jobTitle: site.tagline,
  description: site.bio,
  sameAs,
  image: `${site.url}/avatar.webp`,
})
---

<Base bare description={heroTagline} keywords={`${site.name}, ${site.handle}, portfolio, software engineer`}>
  <script type="application/ld+json" set:html={ldJson} />

  <section data-type="hero" aria-label="Introduction">
    <div data-type="hero-content">
      <div data-type="reticle" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
      <p data-type="kicker">{site.tagline}</p>
      <h1>{site.name}</h1>
      <p data-type="tagline">{heroTagline}</p>
      <nav data-type="hero-links" aria-label="Links">
        <a href={site.social.github} target="_blank" rel="noopener noreferrer">github</a>
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer">linkedin</a>
        <a href="/experience">work</a>
      </nav>
    </div>
  </section>
</Base>
