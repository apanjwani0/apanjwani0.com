---
export const prerender = false

import Base from '../../layouts/Base.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import JsonLd from '../../components/JsonLd.astro'
import { buildBreadcrumbs } from '../../lib/breadcrumbs'
import { getSite, getPosts, isBlogsPublic } from '../../lib/config'
import { blogPostingJsonLd } from '../../lib/jsonld'
import { render } from '../../lib/markdown'
import { formatDisplayDate } from '../../lib/date'

const { slug } = Astro.params
const [site, posts] = await Promise.all([getSite(Astro.locals), getPosts(Astro.locals)])
const noindex = !isBlogsPublic(site)

// Robust matching: normalize both the href from config and the URL slug
// so "/blogs/foo", "blogs/foo", and "foo" all match the slug "foo".
const normalize = (path: string) => path.replace(/^\/?(blogs\/)?/, '').replace(/\/$/, '')
const post = posts.find(p => normalize(p.href) === normalize(slug!))

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const contentHtml = post.content ? render(post.content) : null
const canonicalUrl = `${site.url}/blogs/${normalize(post.href)}`
const ldJson = blogPostingJsonLd({
  headline: post.title,
  description: post.summary,
  url: canonicalUrl,
  datePublished: post.date,
  authorName: site.name,
  authorUrl: site.url,
  keywords: post.keywords,
})

// Visible trail + matching BreadcrumbList (see src/components/Breadcrumbs.astro).
const { crumbs, json: breadcrumbLd } = buildBreadcrumbs([
  { label: 'home', path: '/' },
  { label: 'blogs', path: '/blogs' },
  { label: post.title, path: `/blogs/${normalize(post.href)}` },
], site.url)
---

<Base title={post.title} description={post.summary} keywords={post.keywords} ogType="article" publishedTime={post.date} noindex={noindex}>
  {!noindex && <JsonLd json={ldJson} />}
  {!noindex && <JsonLd json={breadcrumbLd} />}
  <Breadcrumbs items={crumbs} />
  <article>
    <header>
      <h1>{post.title}</h1>
      <time datetime={post.date}>{formatDisplayDate(post.date)}</time>
    </header>
    <section data-type="post-summary">
      <p><em>Summary:</em> {post.summary}</p>
    </section>
    {contentHtml && (
      <section data-type="post-content" set:html={contentHtml} />
    )}
  </article>
</Base>
