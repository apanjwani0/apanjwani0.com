---
export const prerender = false

import Base from '../../layouts/Base.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import RelatedLinks from '../../components/RelatedLinks.astro'
import { getSite, getLearnings } from '../../lib/config'
import { blogPostingJsonLd, breadcrumbListJsonLd } from '../../lib/jsonld'
import { isPublishedLearning, learningEmbedTag } from '../../lib/learnings'
import { existingOgCardPath, learningHasOgCard } from '../../lib/og'
import { render, splitOnEmbed } from '../../lib/markdown'
import { formatDisplayDate } from '../../lib/date'
import '../../styles/games-embed.css'

const { slug } = Astro.params
const [site, learnings] = await Promise.all([getSite(Astro.locals), getLearnings(Astro.locals)])
const cspNonce = (Astro.locals as any).cspNonce

const learning = learnings.find(l => l.slug === slug)

// A draft is readable in dev so the author can preview rendered markdown and the
// embed together — /admin has no preview of its own. In production it does not
// exist, matching the same `import.meta.env.DEV` gate the admin surface uses.
const isDraft = Boolean(learning) && !isPublishedLearning(learning!)
if (!learning || (isDraft && !import.meta.env.DEV)) {
  return new Response(null, { status: 404, statusText: 'Not Found' })
}

const canonicalUrl = `${site.url}/learnings/${learning.slug}`
const pageDescription = learning.metaDescription || learning.summary

// The component to mount inline, or undefined for a prose-only article.
const EmbedTag = learningEmbedTag(learning)

// The figure goes where the WRITING puts it, via a {{embed}} line in the
// markdown. It used to be pinned between the summary and the prose, which is the
// worst available position: the reader meets a simulation before being told what
// it is, and every article then had to open by pointing at "the thing above" —
// which is a large part of why they all read identically.
//
// No marker is a valid article: everything lands in `before` and the figure goes
// after it. A missing marker should cost the position, never the simulation.
const { before, after } = splitOnEmbed(learning.content)
const beforeHtml = render(before)
const afterHtml = after.trim() ? render(after) : ''

const related = learnings
  .filter(l => isPublishedLearning(l) && l.slug !== learning.slug)
  .map(l => ({ title: l.title, href: `/learnings/${l.slug}` }))

// Card only when the generator emits one AND the PNG is really on disk — a
// forgotten `npm run og` degrades to the avatar, never a 404ing og:image.
const ogCard = learningHasOgCard(learning)
  ? await existingOgCardPath('learnings', learning.slug)
  : undefined

const ldJson = blogPostingJsonLd({
  headline: learning.title,
  description: pageDescription,
  url: canonicalUrl,
  datePublished: learning.date,
  authorName: site.name,
  authorUrl: site.url,
  keywords: learning.keywords,
})

// Visible trail + matching BreadcrumbList (see src/components/Breadcrumbs.astro).
// Emitted together or not at all: a breadcrumb path only surfaces in search when
// the markup and the structured data agree.
const crumbs = [
  { label: 'home', href: '/' },
  { label: 'learnings', href: '/learnings' },
  { label: learning.title },
]
const breadcrumbLd = breadcrumbListJsonLd([
  { name: 'Home', url: site.url },
  { name: 'Learnings', url: `${site.url}/learnings` },
  { name: learning.title, url: canonicalUrl },
])
---

<Base
  title={learning.title}
  seoTitle={learning.seoTitle}
  description={pageDescription}
  keywords={learning.keywords}
  noindex={isDraft}
  ogType="article"
  publishedTime={learning.date}
  ogCard={ogCard}
  {/* The decorative star canvas competes for CPU with an embedded simulation —
      the same reason it is off on game pages. Prose-only articles keep it. */}
  starfield={!EmbedTag}
>
  <script nonce={cspNonce} type="application/ld+json" set:html={ldJson} />
  <script nonce={cspNonce} type="application/ld+json" set:html={breadcrumbLd} />
  <Breadcrumbs items={crumbs} />
  <article>
    <header>
      <h1>{learning.title}</h1>
      <time datetime={learning.date}>{formatDisplayDate(learning.date)}</time>
    </header>
    {/* The standfirst — display-size, not a labelled "Summary:" field. It is the
        second thing a reader looks at after the headline, and its job is to make
        them start; a form-label in front of it announced that this was metadata
        about an article rather than the opening of one. */}
    <p data-type="standfirst">{learning.summary}</p>
    <section data-type="post-content" set:html={beforeHtml} />
    {EmbedTag && (
      <figure data-type="learning-embed">
        {/* data-game is what src/lib/game-mount.ts dispatches on — the same
            attribute the game route uses, so one mount function serves both. */}
        <EmbedTag data-game={learning.embed} />
        {learning.embedCaption && <figcaption>{learning.embedCaption}</figcaption>}
      </figure>
    )}
    {afterHtml && <section data-type="post-content" set:html={afterHtml} />}
  </article>
  <RelatedLinks heading="More learnings" items={related} />

  {EmbedTag && (
    <script>
      // Mount on initial load AND after every View Transition navigation. Bundled
      // scripts run once per session, so without astro:page-load an article
      // reached by in-site nav shows an empty element until a hard reload.
      // The component writes its own top-level heading and blurb into itself;
      // inside an article both duplicate the header above. mountEmbed strips them
      // and mounts — see src/lib/game-mount.ts for why that needs an observer,
      // not a sweep. (Angle-bracketed tag names are deliberately spelled out in
      // this comment: a script inside a JSX conditional has its body parsed as
      // JSX, so a literal h1 in angle brackets opens an element that never
      // closes, and the whole file then fails to type-check.)
      import { mountEmbed } from '../../lib/game-mount'
      const mount = () => mountEmbed('figure[data-type="learning-embed"]')
      document.addEventListener('astro:page-load', mount)
      mount()
    </script>
  )}
</Base>

<style>
  /* ── Article typography ───────────────────────────────────────────────
     These articles are meant to be READ, and they were rendering at UI size
     with UI rhythm: 16px, headings a hair larger than body, uniform paragraph
     spacing. The result was a slab — nothing on the page told a skimmer where
     the argument turned, and nothing told a reader where to breathe.

     Everything below is size, weight and space. Tokens only. */

  article {
    max-width: 40rem;
    margin-inline: auto;
  }

  article header h1 {
    font-size: clamp(2rem, 5.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-bottom: 0.75rem;
  }

  article header time {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-muted);
    text-transform: lowercase;
  }

  /* The standfirst — the sentence that decides whether they read the piece. */
  p[data-type="standfirst"] {
    margin: 1.5rem 0 var(--space-section);
    font-size: var(--text-prose-lead);
    line-height: 1.45;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  section[data-type="post-content"] {
    margin-top: 0;
    font-size: var(--text-prose);
    line-height: 1.68;
  }

  section[data-type="post-content"] > :global(p) {
    margin: 0 0 1.25em;
    text-wrap: pretty;
  }

  /* Opening paragraph carries a little more weight than the rest, so the eye
     has somewhere obvious to start after the standfirst. */
  section[data-type="post-content"] > :global(p:first-child) {
    font-size: 1.06em;
  }

  /* Section headings have to be unmistakably heavier than body text — that gap
     IS the document's structure. At the old 1.1rem they were near-invisible. */
  section[data-type="post-content"] :global(h2) {
    margin: 2.4em 0 0.6em;
    font-size: 1.5em;
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-transform: none;
    text-wrap: balance;
  }

  section[data-type="post-content"] :global(h3) {
    margin: 2em 0 0.5em;
    font-size: 1.15em;
    line-height: 1.3;
  }

  section[data-type="post-content"] :global(ul),
  section[data-type="post-content"] :global(ol) {
    margin: 0 0 1.25em;
    padding-left: 1.2em;
  }

  section[data-type="post-content"] :global(li) {
    margin-bottom: 0.5em;
  }

  section[data-type="post-content"] :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 0.15em;
  }

  /* ==highlight== — the clause a section turns on. A tinted background rather
     than bold: bold is already doing a job inside these articles, and a reader
     scanning for "the important bit" should find one signal, not two. */
  section[data-type="post-content"] :global(mark) {
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
    color: inherit;
    padding: 0.08em 0.22em;
    border-radius: var(--radius-sm);
  }

  /* >> pull quote — breaks the column so the page has a visible pulse. */
  section[data-type="post-content"] :global(p[data-type="pull-quote"]) {
    margin: 2em 0;
    padding-left: 1em;
    border-left: 3px solid var(--color-accent);
    font-size: 1.35em;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-wrap: balance;
  }

  /* :::note / :::key / :::aside / :::warn — the takeaway and the tangent, so
     neither has to sit in the main line pretending to be a paragraph. */
  section[data-type="post-content"] :global(aside[data-type="callout"]) {
    margin: 1.8em 0;
    padding: 1rem 1.15rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-muted);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    font-size: 0.94em;
  }

  section[data-type="post-content"] :global(aside[data-kind="key"]) {
    border-left-color: var(--color-accent);
  }

  section[data-type="post-content"] :global(aside[data-kind="warn"]) {
    border-left-color: var(--color-error);
  }

  section[data-type="post-content"] :global(aside[data-type="callout"] > *:last-child) {
    margin-bottom: 0;
  }

  section[data-type="post-content"] :global(p[data-type="callout-label"]) {
    margin: 0 0 0.4em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  /* A real quotation, kept visually distinct from the pull quote above. */
  section[data-type="post-content"] :global(blockquote) {
    margin: 1.8em 0;
    padding-left: 1.1em;
    border-left: 1px solid var(--color-border);
    color: var(--color-muted);
    font-style: italic;
  }

  @media (max-width: 560px) {
    article {
      max-width: none;
    }
  }

  /* The embed reads as a figure rather than as the page's main subject: its own
     breathing room and a caption saying what the reader is looking at. Its
     POSITION now comes from a {{embed}} line in the article source — see the
     frontmatter. Tokens only. */
  figure[data-type="learning-embed"] {
    margin: var(--space-section) 0;
  }

  /* The component's own title block, hidden before it can paint — the script
     above then removes it outright. :global() is required: this markup is
     written by the component at runtime and never carries Astro's scope hash. */
  figure[data-type="learning-embed"] :global([data-type$="-header"]),
  figure[data-type="learning-embed"] :global(h1) {
    display: none;
  }

  figure[data-type="learning-embed"] figcaption {
    margin-top: var(--space-xs);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
