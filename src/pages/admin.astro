---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite, getProjects, getExperience, getPosts, getGames, getTools } from '../lib/config'
import { validateSession } from '../lib/session'
import { getAdminSecret, getRuntimeEnv, getSessionToken, isAdminRequestAllowed } from '../lib/security'

// Auth: read secret from Cloudflare env (prod) or process.env/.env (dev/Node)
const runtimeEnv = getRuntimeEnv(Astro.locals)
const secret = getAdminSecret(Astro.locals)

// In dev with no secret configured, allow through without auth
const bypassAuth = import.meta.env.DEV && !secret

// In production: 404 unless the request IP is in the whitelist
// Set ADMIN_IP_WHITELIST as a comma-separated list of allowed IPs in your environment variables
const blocked = !isAdminRequestAllowed(Astro.request, Astro.locals)
if (blocked) Astro.response.status = 404

// Skip all data loading for blocked requests
const token = blocked ? undefined : getSessionToken(Astro.request)
const isAuth = !blocked && (bypassAuth || await validateSession(token, runtimeEnv?.SITE_CONFIG))

const loginError = blocked ? null : Astro.url.searchParams.get('error')

// Load from KV (or fallback to bundled TS) so admin always shows live values
const [site, projects, experience, posts, games, toolItems] = blocked
  ? [null, null, null, null, null, null]
  : await Promise.all([
      getSite(Astro.locals),
      getProjects(Astro.locals),
      getExperience(Astro.locals),
      getPosts(Astro.locals),
      getGames(Astro.locals),
      getTools(Astro.locals),
    ])

const siteConfig = site!
const projectItems = projects!
const companyItems = experience!
const postItems = posts!
const gameItems = games!
const tools = toolItems!
const navJson = blocked ? '{}' : JSON.stringify(siteConfig.nav)
const sectionsJson = blocked ? '{}' : JSON.stringify(siteConfig.sections)
---

{blocked ? (
  <Base title="404">
    <h1>404</h1>
    <p>This page doesn't exist.</p>
    <a href="/">Go home</a>
  </Base>
) : (
<Base title="admin" noindex={true}>
  <h1>admin</h1>

  {!isAuth ? (
    <div id="auth-gate">
      {loginError && <p id="login-error">incorrect password</p>}
      <form id="login-form">
        <label>
          password
          <div id="pw-field">
            <input type="password" name="password" id="pw-input" autocomplete="current-password" autofocus />
            <button type="button" id="pw-toggle">show</button>
          </div>
        </label>
        <button type="submit" id="login-btn">login</button>
      </form>
    </div>
  ) : (<>

  <div class="tabs">
    <button class="tab active" data-tab="site">site</button>
    <button class="tab" data-tab="projects">projects</button>
    <button class="tab" data-tab="experience">experience</button>
    <button class="tab" data-tab="blogs">blogs</button>
    <button class="tab" data-tab="games">games</button>
    <button class="tab" data-tab="tools">tools</button>
    <button class="tab" data-tab="analytics">analytics</button>
  </div>

  <!-- Site -->
  <section id="tab-site" class="tab-panel">
    <form id="form-site">
      <input type="hidden" name="nav" value={navJson} />
      <input type="hidden" name="sections" value={sectionsJson} />
      <label>name<input name="name" value={siteConfig.name} /></label>
      <label>handle<input name="handle" value={siteConfig.handle} /></label>
      <label>site url<input name="url" value={siteConfig.url} /></label>
      <label>tagline<input name="tagline" value={siteConfig.tagline} /></label>
      <label>bio<textarea name="bio">{siteConfig.bio}</textarea></label>
      <label>avatar path<input name="avatar" value={siteConfig.avatar} /></label>
      <label>theme
        <select name="theme">
          <option value="light" selected={siteConfig.theme === 'light'}>light</option>
          <option value="dark" selected={siteConfig.theme === 'dark'}>dark</option>
        </select>
      </label>
      <label>github<input name="github" value={siteConfig.social.github} /></label>
      <label>linkedin<input name="linkedin" value={siteConfig.social.linkedin} /></label>
      <div class="form-actions">
        <button type="submit">save site</button>
      </div>
    </form>
  </section>

  <!-- Projects -->
  <section id="tab-projects" class="tab-panel hidden">
    <div id="projects-list">
      {projectItems.map((p) => (
        <div class="item">
          <div class="drag-handle" title="drag to reorder">⠿</div>
          <label>title<input name="title" value={p.title} /></label>
          <label>url<input name="url" value={p.url} /></label>
          <label>description<textarea name="description">{p.description}</textarea></label>
          <label>tags (comma-separated)<input name="tags" value={p.tags.join(', ')} /></label>
          <label>keywords (optional seo)<input name="keywords" value={p.keywords ?? ''} /></label>
          <button type="button" class="remove-btn">remove</button>
        </div>
      ))}
    </div>
    <div class="form-actions">
      <button type="button" id="add-project" class="add-btn">+ add project</button>
      <button type="button" id="save-projects">save projects</button>
    </div>
  </section>

  <!-- Experience -->
  <section id="tab-experience" class="tab-panel hidden">
    <div id="experience-list">
      {companyItems.map((company) => (
        <div class="company-item">
          <div class="company-header">
            <label>company<input name="company-name" value={company.name} /></label>
            <button type="button" class="remove-company-btn">remove company</button>
          </div>
          <div class="roles-list">
            {company.roles.map((role) => (
              <div class="role-item">
                <label>title<input name="role-title" value={role.title} /></label>
                <label>team (optional)<input name="role-team" value={role.team ?? ''} /></label>
                <label>period<input name="role-period" value={role.period} /></label>
                <label>bullets (one per line)<textarea name="role-bullets">{role.bullets.join('\n')}</textarea></label>
                <button type="button" class="remove-role-btn">remove role</button>
              </div>
            ))}
          </div>
          <div class="form-actions">
            <button type="button" class="add-role-btn add-btn">+ add role</button>
          </div>
        </div>
      ))}
    </div>
    <div class="form-actions">
      <button type="button" id="add-company" class="add-btn">+ add company</button>
      <button type="button" id="save-experience">save experience</button>
    </div>
  </section>

  <!-- Writing -->
  <section id="tab-blogs" class="tab-panel hidden">
    <div id="blogs-list">
      {postItems.map((p) => (
        <div class="item">
          <label>title<input name="title" value={p.title} /></label>
          <label>href<input name="href" value={p.href} /></label>
          <label>date<input name="date" type="date" value={p.date} /></label>
          <label>summary<textarea name="summary">{p.summary}</textarea></label>
          <label>content (markdown)<textarea name="content" rows="10">{p.content}</textarea></label>
          <label>keywords (optional seo)<input name="keywords" value={p.keywords ?? ''} /></label>
          <button type="button" class="remove-btn">remove</button>
        </div>
      ))}
    </div>
    <div class="form-actions">
      <button type="button" id="add-post" class="add-btn">+ add post</button>
      <button type="button" id="save-blogs">save blogs</button>
    </div>
  </section>

  <!-- Games -->
  <section id="tab-games" class="tab-panel hidden">
    <div id="games-list">
      {gameItems.map((g) => (
        <div class="item">
          <label>title<input name="title" value={g.title} /></label>
          <label>slug<input name="slug" value={g.slug} /></label>
          <label>seo title<input name="seoTitle" value={g.seoTitle ?? ''} /></label>
          <label>meta description<input name="metaDescription" value={g.metaDescription ?? ''} /></label>
          <label>description<textarea name="description">{g.description}</textarea></label>
          <label>intro (optional)<textarea name="intro">{g.intro ?? ''}</textarea></label>
          <label>seo content (markdown)<textarea name="seoContent" rows="8">{g.seoContent ?? ''}</textarea></label>
          <label>keywords (optional seo)<input name="keywords" value={g.keywords ?? ''} /></label>
          <label class="toggle-label">
            enabled
            <input name="enabled" type="checkbox" checked={g.enabled} />
          </label>
          <label class="toggle-label">
            interactive (playable component)
            <input name="interactive" type="checkbox" checked={g.interactive} />
          </label>
        </div>
      ))}
    </div>
    <div class="form-actions">
      <button type="button" id="add-game" class="add-btn">+ add game</button>
      <button type="button" id="save-games">save games</button>
    </div>
  </section>

  <!-- Tools -->
  <section id="tab-tools" class="tab-panel hidden">
    <ul class="tools-list">
      {tools.map(tool => (
        <li class="tool-item">
          <a href={`/tools/${tool.slug}`} class="tool-link">{tool.title}</a>
          <span class={`tool-status tool-status--${tool.status}`}>{tool.status}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Analytics -->
  <section id="tab-analytics" class="tab-panel hidden">
    <div class="form-actions">
      <button type="button" id="refresh-analytics" class="add-btn">refresh analytics</button>
      <span class="analytics-note">aggregate tool/game views only — no ids, ips, or raw referrers</span>
    </div>
    <div class="analytics-table-wrap">
      <table class="analytics-table">
        <thead>
          <tr>
            <th>type</th>
            <th>slug</th>
            <th>views</th>
            <th>direct</th>
            <th>direct %</th>
            <th>avg load</th>
            <th>avg route</th>
            <th>avg lcp</th>
            <th>avg ttfb</th>
          </tr>
        </thead>
        <tbody id="analytics-body">
          <tr><td colspan="9" class="analytics-empty">open this tab to load analytics</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <div id="toast" class="toast hidden"></div>

  <form method="POST" action="/api/admin/logout" style="margin-top: 3rem;" data-astro-reload>
    <button type="submit" class="logout-btn">logout</button>
  </form>
  </>)}
</Base>
)}

<style>
  .tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .tab {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0.5rem 0;
    margin-right: 1.75rem;
    margin-bottom: -1px;
    font: inherit;
    font-size: 0.95rem;
    color: var(--color-muted);
    cursor: pointer;
  }

  .tab.active {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .tab:hover:not(.active) {
    color: var(--color-text);
  }

  .tab-panel {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .tab-panel.hidden {
    display: none;
  }

  #form-site {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 540px;
  }

  .item {
    border: 1px solid var(--color-border);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: opacity 0.15s;
  }

  .item.dragging {
    opacity: 0.3;
  }

  .item.drag-over {
    border-color: var(--color-text);
  }

  .drag-handle {
    cursor: grab;
    color: var(--color-muted);
    font-size: 1.1rem;
    user-select: none;
    align-self: flex-start;
    line-height: 1;
    padding: 0 0.1rem;
  }

  .drag-handle:hover {
    color: var(--color-text);
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--color-muted);
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  input:not([type="checkbox"]), textarea, select {
    font: inherit;
    font-size: 0.95rem;
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.6rem;
    background: var(--color-bg);
    color: var(--color-text);
    width: 100%;
    box-sizing: border-box;
  }

  .toggle-label {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  input[type="checkbox"] {
    width: auto;
    cursor: pointer;
  }

  textarea {
    min-height: 72px;
    resize: vertical;
  }

  .form-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.25rem;
  }

  button[type="submit"],
  #save-projects,
  #save-experience,
  #save-blogs,
  #save-games {
    background: var(--color-text);
    color: var(--color-bg);
    border: none;
    padding: 0.45rem 1.1rem;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .add-btn {
    background: none;
    border: 1px solid var(--color-border);
    padding: 0.45rem 1rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--color-text);
    cursor: pointer;
  }

  .remove-btn {
    background: none;
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.75rem;
    font: inherit;
    font-size: 0.8rem;
    color: var(--color-muted);
    cursor: pointer;
    align-self: flex-start;
  }

  .company-item {
    border: 1px solid var(--color-border);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .company-header {
    display: flex;
    gap: 1rem;
    align-items: flex-end;
  }

  .company-header label {
    flex: 1;
  }

  .roles-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-border);
  }

  .role-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
  }

  .remove-company-btn,
  .remove-role-btn {
    background: none;
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.75rem;
    font: inherit;
    font-size: 0.8rem;
    color: var(--color-muted);
    cursor: pointer;
    white-space: nowrap;
    align-self: flex-end;
  }

  .toast {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    padding: 0.65rem 1.1rem;
    font-size: 0.9rem;
    z-index: 100;
    transition: opacity 0.2s;
  }

  .toast.hidden { display: none; }
  .toast.success { background: var(--color-text); color: var(--color-bg); }
  /* Error surfaces read from the theme's error/bg tokens instead of a hardcoded
     red, so they track the active theme (dark: light-red on near-black) and stay
     legible in both themes — near-black on the dark-red light theme, near-black
     on the light-red dark theme. */
  .toast.error { background: var(--color-error); color: var(--color-bg); }

  #auth-gate {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 320px;
    margin-top: 1rem;
  }

  #login-error {
    color: var(--color-error);
    font-size: 0.85rem;
    margin: 0;
  }

  #login-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #pw-field {
    display: flex;
    gap: 0;
  }

  #pw-field input {
    flex: 1;
    border-right: none;
  }

  #pw-toggle {
    background: none;
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.7rem;
    font: inherit;
    font-size: 0.8rem;
    color: var(--color-muted);
    cursor: pointer;
    white-space: nowrap;
  }

  #pw-toggle:hover {
    color: var(--color-text);
  }

  #login-btn {
    background: var(--color-text);
    color: var(--color-bg);
    border: none;
    padding: 0.45rem 1.1rem;
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    align-self: flex-start;
    transition: opacity 0.15s;
  }

  #login-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .logout-btn {
    background: none;
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.9rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--color-muted);
    cursor: pointer;
  }

  .tools-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .tool-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .tool-link {
    font-size: 0.95rem;
  }

  .tool-status {
    font-size: 0.75rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }

  .tool-status--disabled {
    color: var(--color-error);
    border-color: var(--color-error);
  }

  .analytics-note,
  .analytics-empty {
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  .analytics-table-wrap {
    overflow-x: auto;
  }

  .analytics-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
  }

  .analytics-table th,
  .analytics-table td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.45rem 0.55rem;
    text-align: left;
    white-space: nowrap;
  }
</style>

<script>
  // Login form interactivity
  const pwToggle = document.getElementById('pw-toggle')
  const pwInput = document.getElementById('pw-input') as HTMLInputElement | null
  const loginBtn = document.getElementById('login-btn') as HTMLButtonElement | null
  const loginForm = document.getElementById('login-form') as HTMLFormElement | null

  pwToggle?.addEventListener('click', () => {
    if (!pwInput) return
    const isHidden = pwInput.type === 'password'
    pwInput.type = isHidden ? 'text' : 'password'
    pwToggle.textContent = isHidden ? 'hide' : 'show'
    pwInput.focus()
  })

  loginForm?.addEventListener('submit', async e => {
    e.preventDefault()
    if (loginBtn) { loginBtn.disabled = true; loginBtn.textContent = 'logging in...' }

    try {
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: pwInput?.value ?? '' }),
      })
      const json = await res.json()
      if (json.ok) {
        window.location.href = '/admin'
      } else {
        const errEl = document.getElementById('login-error')
        if (errEl) errEl.textContent = json.error ?? 'incorrect password'
        else {
          const p = document.createElement('p')
          p.id = 'login-error'
          p.textContent = json.error ?? 'incorrect password'
          loginForm.insertAdjacentElement('beforebegin', p)
        }
        if (loginBtn) { loginBtn.disabled = false; loginBtn.textContent = 'login' }
      }
    } catch {
      if (loginBtn) { loginBtn.disabled = false; loginBtn.textContent = 'login' }
    }
  })

  // Admin panel — only runs when authenticated (elements exist in DOM)
  if (document.getElementById('form-site')) {

  // Tab switching
  document.querySelectorAll<HTMLButtonElement>('.tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'))
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'))
      btn.classList.add('active')
      document.getElementById(`tab-${btn.dataset.tab}`)?.classList.remove('hidden')
      if (btn.dataset.tab === 'analytics') loadAnalytics()
    })
  })

  // Remove item (delegated) — handles flat items, role items, and company blocks
  document.addEventListener('click', e => {
    const target = e.target as HTMLElement
    if (target.classList.contains('remove-btn')) {
      target.closest('.item')?.remove()
    }
    if (target.classList.contains('remove-role-btn')) {
      target.closest('.role-item')?.remove()
    }
    if (target.classList.contains('remove-company-btn')) {
      target.closest('.company-item')?.remove()
    }
    if (target.classList.contains('add-role-btn')) {
      target.closest('.company-item')?.querySelector('.roles-list')
        ?.insertAdjacentHTML('beforeend', roleItemHTML())
    }
  })

  // Toast
  function showToast(msg: string, isError = false) {
    const toast = document.getElementById('toast')!
    toast.textContent = msg
    toast.className = `toast ${isError ? 'error' : 'success'}`
    setTimeout(() => { toast.className = 'toast hidden' }, 3000)
  }

  type AnalyticsRow = {
    kind: string
    slug: string
    views: number
    directEntries: number
    directRate: number
    avgLoadMs: number | null
    avgRouteMs: number | null
    avgLcpMs: number | null
    avgTtfbMs: number | null
  }

  let analyticsLoaded = false

  function formatMs(value: number | null) {
    return value === null ? '—' : `${Math.round(value)} ms`
  }

  function addAnalyticsCell(row: HTMLTableRowElement, value: string | number) {
    const cell = document.createElement('td')
    cell.textContent = String(value)
    row.appendChild(cell)
  }

  function renderAnalyticsRows(rows: AnalyticsRow[]) {
    const body = document.getElementById('analytics-body')!
    body.replaceChildren()

    if (rows.length === 0) {
      const row = document.createElement('tr')
      const cell = document.createElement('td')
      cell.colSpan = 9
      cell.className = 'analytics-empty'
      cell.textContent = 'no tool or game views recorded yet'
      row.appendChild(cell)
      body.appendChild(row)
      return
    }

    for (const item of rows) {
      const row = document.createElement('tr')
      addAnalyticsCell(row, item.kind)
      addAnalyticsCell(row, item.slug)
      addAnalyticsCell(row, item.views)
      addAnalyticsCell(row, item.directEntries)
      addAnalyticsCell(row, `${item.directRate}%`)
      addAnalyticsCell(row, formatMs(item.avgLoadMs))
      addAnalyticsCell(row, formatMs(item.avgRouteMs))
      addAnalyticsCell(row, formatMs(item.avgLcpMs))
      addAnalyticsCell(row, formatMs(item.avgTtfbMs))
      body.appendChild(row)
    }
  }

  async function loadAnalytics(force = false) {
    if (analyticsLoaded && !force) return
    const body = document.getElementById('analytics-body')!
    body.innerHTML = '<tr><td colspan="9" class="analytics-empty">loading analytics...</td></tr>'

    try {
      const res = await fetch('/api/admin/analytics')
      if (!res.ok) throw new Error()
      const json = await res.json()
      renderAnalyticsRows(Array.isArray(json.rows) ? json.rows : [])
      analyticsLoaded = true
    } catch {
      body.innerHTML = '<tr><td colspan="9" class="analytics-empty">failed to load analytics</td></tr>'
    }
  }

  document.getElementById('refresh-analytics')?.addEventListener('click', () => loadAnalytics(true))

  // Save
  async function save(type: string, data: unknown) {
    try {
      const res = await fetch('/api/admin/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, data }),
      })
      const json = await res.json()
      if (json.ok) {
        showToast(`${type} saved`)
      } else {
        showToast(json.error ?? 'Save failed', true)
      }
    } catch {
      showToast('Save failed', true)
    }
  }

  // --- Site ---
  // Live theme preview when select changes
  document.querySelector<HTMLSelectElement>('select[name="theme"]')
    ?.addEventListener('change', e => {
      document.documentElement.setAttribute('data-theme', (e.target as HTMLSelectElement).value)
    })

  document.getElementById('form-site')!.addEventListener('submit', async e => {
    e.preventDefault()
    const fd = new FormData(e.target as HTMLFormElement)
    const theme = fd.get('theme') as string
    await save('site', {
      name: fd.get('name'),
      handle: fd.get('handle'),
      url: fd.get('url'),
      theme,
      tagline: fd.get('tagline'),
      bio: fd.get('bio'),
      avatar: fd.get('avatar'),
      nav: JSON.parse(fd.get('nav') as string),
      social: {
        github: fd.get('github'),
        linkedin: fd.get('linkedin'),
      },
      sections: JSON.parse(fd.get('sections') as string),
    })
    // Apply theme to DOM immediately — no reload needed
    document.documentElement.setAttribute('data-theme', theme)
  })

  // --- Projects ---
  function projectItemHTML() {
    return `<div class="item">
      <div class="drag-handle" title="drag to reorder">⠿</div>
      <label>title<input name="title" value="" /></label>
      <label>url<input name="url" value="" /></label>
      <label>description<textarea name="description"></textarea></label>
      <label>tags (comma-separated)<input name="tags" value="" /></label>
      <label>keywords (optional seo)<input name="keywords" value="" /></label>
      <button type="button" class="remove-btn">remove</button>
    </div>`
  }

  // Drag-to-reorder — reorders DOM nodes; save-projects reads DOM order
  // draggable is set dynamically on mousedown of the handle only,
  // so text selection inside the card works normally.
  const projectsList = document.getElementById('projects-list')!
  let dragSrc: HTMLElement | null = null

  projectsList.addEventListener('mousedown', e => {
    const item = (e.target as HTMLElement).closest('.item') as HTMLElement | null
    if (!item) return
    item.draggable = !!(e.target as HTMLElement).closest('.drag-handle')
  })

  projectsList.addEventListener('dragstart', e => {
    const item = (e.target as HTMLElement).closest('.item') as HTMLElement | null
    if (!item || !item.draggable) return
    dragSrc = item
    // Defer class add so the drag ghost captures the un-faded style
    requestAnimationFrame(() => item.classList.add('dragging'))
    e.dataTransfer!.effectAllowed = 'move'
  })

  projectsList.addEventListener('dragend', () => {
    dragSrc?.classList.remove('dragging')
    if (dragSrc) dragSrc.draggable = false
    projectsList.querySelectorAll('.item').forEach(el => el.classList.remove('drag-over'))
    dragSrc = null
  })

  projectsList.addEventListener('dragover', e => {
    e.preventDefault()
    e.dataTransfer!.dropEffect = 'move'
    const item = (e.target as HTMLElement).closest('.item') as HTMLElement | null
    if (!item || item === dragSrc) return
    projectsList.querySelectorAll('.item').forEach(el => el.classList.remove('drag-over'))
    item.classList.add('drag-over')
  })

  projectsList.addEventListener('dragleave', e => {
    const related = e.relatedTarget as HTMLElement | null
    if (related?.closest('.item') !== (e.target as HTMLElement).closest('.item')) {
      ;(e.target as HTMLElement).closest('.item')?.classList.remove('drag-over')
    }
  })

  projectsList.addEventListener('drop', e => {
    e.preventDefault()
    const item = (e.target as HTMLElement).closest('.item') as HTMLElement | null
    if (!item || !dragSrc || item === dragSrc) return
    item.classList.remove('drag-over')
    const mid = item.getBoundingClientRect().top + item.getBoundingClientRect().height / 2
    if (e.clientY < mid) {
      projectsList.insertBefore(dragSrc, item)
    } else {
      item.after(dragSrc)
    }
  })

  document.getElementById('add-project')!.addEventListener('click', () => {
    document.getElementById('projects-list')!.insertAdjacentHTML('beforeend', projectItemHTML())
  })

  document.getElementById('save-projects')!.addEventListener('click', async () => {
    const items = document.getElementById('projects-list')!.querySelectorAll('.item')
    const data = Array.from(items).map(item => ({
      title: (item.querySelector('[name="title"]') as HTMLInputElement).value,
      url: (item.querySelector('[name="url"]') as HTMLInputElement).value,
      description: (item.querySelector('[name="description"]') as HTMLTextAreaElement).value,
      tags: (item.querySelector('[name="tags"]') as HTMLInputElement).value
        .split(',').map(t => t.trim()).filter(Boolean),
      keywords: (item.querySelector('[name="keywords"]') as HTMLInputElement).value.trim() || undefined,
    }))
    await save('projects', data)
  })

  // --- Experience ---
  function roleItemHTML() {
    return `<div class="role-item">
      <label>title<input name="role-title" value="" /></label>
      <label>team (optional)<input name="role-team" value="" /></label>
      <label>period<input name="role-period" value="" /></label>
      <label>bullets (one per line)<textarea name="role-bullets"></textarea></label>
      <button type="button" class="remove-role-btn">remove role</button>
    </div>`
  }

  function companyItemHTML() {
    return `<div class="company-item">
      <div class="company-header">
        <label>company<input name="company-name" value="" /></label>
        <button type="button" class="remove-company-btn">remove company</button>
      </div>
      <div class="roles-list">
        ${roleItemHTML()}
      </div>
      <div class="form-actions">
        <button type="button" class="add-role-btn add-btn">+ add role</button>
      </div>
    </div>`
  }

  document.getElementById('add-company')!.addEventListener('click', () => {
    document.getElementById('experience-list')!.insertAdjacentHTML('beforeend', companyItemHTML())
  })

  document.getElementById('save-experience')!.addEventListener('click', async () => {
    const companies = document.getElementById('experience-list')!.querySelectorAll('.company-item')
    const data = Array.from(companies).map(company => {
      const roles = company.querySelectorAll('.role-item')
      return {
        name: (company.querySelector('[name="company-name"]') as HTMLInputElement).value,
        roles: Array.from(roles).map(role => {
          const team = (role.querySelector('[name="role-team"]') as HTMLInputElement).value.trim()
          return {
            title: (role.querySelector('[name="role-title"]') as HTMLInputElement).value,
            ...(team ? { team } : {}),
            period: (role.querySelector('[name="role-period"]') as HTMLInputElement).value,
            bullets: (role.querySelector('[name="role-bullets"]') as HTMLTextAreaElement).value
              .split('\n').map(b => b.trim()).filter(Boolean),
          }
        }),
      }
    })
    await save('experience', data)
  })

  // --- Writing ---
  function blogsItemHTML() {
    return `<div class="item">
      <label>title<input name="title" value="" /></label>
      <label>href<input name="href" value="" /></label>
      <label>date<input name="date" type="date" value="" /></label>
      <label>summary<textarea name="summary"></textarea></label>
      <label>content (markdown)<textarea name="content" rows="10"></textarea></label>
      <label>keywords (optional seo)<input name="keywords" value="" /></label>
      <button type="button" class="remove-btn">remove</button>
    </div>`
  }

  document.getElementById('add-post')!.addEventListener('click', () => {
    document.getElementById('blogs-list')!.insertAdjacentHTML('beforeend', blogsItemHTML())
  })

  document.getElementById('save-blogs')!.addEventListener('click', async () => {
    const items = document.getElementById('blogs-list')!.querySelectorAll('.item')
    const data = Array.from(items).map(item => ({
      title: (item.querySelector('[name="title"]') as HTMLInputElement).value,
      href: (item.querySelector('[name="href"]') as HTMLInputElement).value,
      date: (item.querySelector('[name="date"]') as HTMLInputElement).value,
      summary: (item.querySelector('[name="summary"]') as HTMLTextAreaElement).value,
      content: (item.querySelector('[name="content"]') as HTMLTextAreaElement).value.trim() || undefined,
      keywords: (item.querySelector('[name="keywords"]') as HTMLInputElement).value.trim() || undefined,
    }))
    await save('blogs', data)
  })

  // --- Games ---
  function gamesItemHTML() {
    return `<div class="item">
      <label>title<input name="title" value="" /></label>
      <label>slug<input name="slug" value="" /></label>
      <label>seo title<input name="seoTitle" value="" /></label>
      <label>meta description<input name="metaDescription" value="" /></label>
      <label>description<textarea name="description"></textarea></label>
      <label>intro (optional)<textarea name="intro"></textarea></label>
      <label>seo content (markdown)<textarea name="seoContent" rows="8"></textarea></label>
      <label>keywords (optional seo)<input name="keywords" value="" /></label>
      <label class="toggle-label">
        enabled
        <input name="enabled" type="checkbox" />
      </label>
      <label class="toggle-label">
        interactive (playable component)
        <input name="interactive" type="checkbox" />
      </label>
    </div>`
  }

  document.getElementById('add-game')!.addEventListener('click', () => {
    document.getElementById('games-list')!.insertAdjacentHTML('beforeend', gamesItemHTML())
  })

  document.getElementById('save-games')!.addEventListener('click', async () => {
    const items = document.getElementById('games-list')!.querySelectorAll('.item')
    const data = Array.from(items).map(item => ({
      slug: (item.querySelector('[name="slug"]') as HTMLInputElement).value,
      title: (item.querySelector('[name="title"]') as HTMLInputElement).value,
      seoTitle: (item.querySelector('[name="seoTitle"]') as HTMLInputElement).value.trim() || undefined,
      metaDescription: (item.querySelector('[name="metaDescription"]') as HTMLInputElement).value.trim() || undefined,
      description: (item.querySelector('[name="description"]') as HTMLTextAreaElement).value,
      intro: (item.querySelector('[name="intro"]') as HTMLTextAreaElement).value.trim() || undefined,
      seoContent: (item.querySelector('[name="seoContent"]') as HTMLTextAreaElement).value.trim() || undefined,
      enabled: (item.querySelector('[name="enabled"]') as HTMLInputElement).checked,
      keywords: (item.querySelector('[name="keywords"]') as HTMLInputElement).value.trim() || undefined,
      interactive: (item.querySelector('[name="interactive"]') as HTMLInputElement).checked || undefined,
    }))
    await save('games', data)
  })

  } // end admin guard
</script>
