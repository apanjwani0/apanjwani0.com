---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite, getGames } from '../lib/config'
import { render } from '../lib/markdown'
import { itemListJsonLd } from '../lib/jsonld'

const [site, games] = await Promise.all([
  getSite(Astro.locals),
  getGames(Astro.locals).then(gs => gs.filter(g => g.enabled)),
])

const ldJson = itemListJsonLd(
  'Games by Aman Panjwani',
  games.map(g => ({ name: g.title, url: `${site.url}/games/${g.slug}` })),
)
---

<Base
  title="games"
  description="Browser games and playable experiments by Aman Panjwani — an interactive Conway's Game of Life, a seeded Flow Field generative-art toy, a Type Trial typing-speed race and a hex-colour guessing game. No downloads, no sign-up; everything runs right in your browser."
  keywords="browser games, conway's game of life, online game of life, cellular automaton, flow field generator, generative art, typing game, typing speed test, wpm game, hex color game, playable experiments, generative games, no-download games"
>
  {games.length > 0 && <script type="application/ld+json" set:html={ldJson} />}
  <h1>games</h1>
  <p data-type="page-intro">
    Browser games and playable experiments — little things I build for the fun of it.
    The ones marked play are live now; the rest are on the way.
  </p>
  {games.length === 0 ? (
    <p>Coming soon.</p>
  ) : (
    <div>
      {games.map(g => (
        <article data-type="project">
          <div data-type="project-header">
            <a href={`/games/${g.slug}`}>{g.title}</a>
            <span data-type="project-stats">
              {g.interactive ? (
                <span data-type="game-badge" data-live>play <span aria-hidden="true">&rsaquo;</span></span>
              ) : (
                <span data-type="game-badge">coming soon</span>
              )}
            </span>
          </div>
          <div data-type="project-description" set:html={render(g.description)} />
        </article>
      ))}
    </div>
  )}
</Base>

<style>
  /* Status pill on each game card — replaces the previous duplicated inline
     styles; live vs coming-soon differ only by colour. Tokens only. */
  [data-type="game-badge"] {
    font-size: var(--text-xs);
    border: 1px solid var(--color-border);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius);
    white-space: nowrap;
  }

  [data-type="game-badge"][data-live] {
    color: var(--color-success);
    border-color: var(--color-success);
  }
</style>
