---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite, getGames } from '../lib/config'
import { render } from '../lib/markdown'
import { itemListJsonLd } from '../lib/jsonld'

const [site, games] = await Promise.all([
  getSite(Astro.locals),
  getGames(Astro.locals).then(gs => gs.filter(g => g.enabled)),
])
const cspNonce = (Astro.locals as any).cspNonce

const ldJson = itemListJsonLd(
  'Games by Aman Panjwani',
  games.map(g => ({ name: g.title, url: `${site.url}/games/${g.slug}` })),
)
---

<Base
  wide
  title="games"
  description="Free browser games and playable experiments — Quintle (a daily five-letter word puzzle), 2048, Conway's Game of Life, a boids flocking sim, a reaction-diffusion Turing-pattern playground, an L-system fractal garden, a self-solving maze, a warp-speed starfield, a hex-colour guessing game, and a typing race. No downloads, no sign-up."
  keywords="browser games, word game, word guessing game, five letter word game, daily word puzzle, wordle style game, quintle, 2048, 2048 puzzle, sliding tile game, number puzzle, conway's game of life, cellular automaton, flow field generator, generative art, starfield, warp speed, boids, flocking simulation, murmuration, swarm, reaction diffusion, gray-scott, turing pattern, morphogenesis, l-system, lindenmayer system, fractal plant, fractal tree, koch curve, dragon curve, sierpinski, maze generator, maze solver, pathfinding visualizer, bfs, a star, typing game, typing speed test, hex color game, playable experiments, no-download games"
>
  {games.length > 0 && <script nonce={cspNonce} type="application/ld+json" set:html={ldJson} />}
  <h1>games</h1>
  <p data-type="page-intro">
    Browser games and playable experiments — a daily five-letter word puzzle, a game of 2048, a maze that solves itself,
    a flock that swarms from three simple rules, a reaction-diffusion dish that blooms Turing patterns, a fractal garden that grows itself
    from an L-system, a starfield you fly through, a colour-guessing game to test your eye, and a few other things I built for the fun of it.
    Everything marked play runs right here, no downloads and no sign-up; the rest are on the way.
  </p>
  {games.length === 0 ? (
    <p>Coming soon.</p>
  ) : (
    <div data-type="card-grid">
      {games.map(g => (
        <article data-type="project">
          <div data-type="project-header">
            <h2 data-type="card-title"><a href={`/games/${g.slug}`}>{g.title}</a></h2>
            <span data-type="project-stats">
              {g.interactive ? (
                <span data-type="game-badge" data-live>play <span aria-hidden="true">&rsaquo;</span></span>
              ) : (
                <span data-type="game-badge">coming soon</span>
              )}
            </span>
          </div>
          <div data-type="project-description" set:html={render(g.description)} />
        </article>
      ))}
    </div>
  )}
</Base>

<style>
  /* Status pill on each game card — replaces the previous duplicated inline
     styles; live vs coming-soon differ only by colour. Tokens only. */
  [data-type="game-badge"] {
    font-size: var(--text-xs);
    border: 1px solid var(--color-border);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius);
    white-space: nowrap;
  }

  [data-type="game-badge"][data-live] {
    color: var(--color-success);
    border-color: var(--color-success);
  }
</style>
