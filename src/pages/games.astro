---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite, getGames } from '../lib/config'
import { render } from '../lib/markdown'
import { itemListJsonLd } from '../lib/jsonld'

const [site, games] = await Promise.all([
  getSite(Astro.locals),
  getGames(Astro.locals).then(gs => gs.filter(g => g.enabled)),
])

const ldJson = itemListJsonLd(
  'Games by Aman Panjwani',
  games.map(g => ({ name: g.title, url: `${site.url}/games/${g.slug}` })),
)
---

<Base
  title="games"
  description="Browser games and playable experiments by Aman Panjwani — built for fun."
>
  {games.length > 0 && <script type="application/ld+json" set:html={ldJson} />}
  <h1>games</h1>
  <p data-type="page-intro">
    Browser games and playable experiments — little things I build for the fun of it.
    Everything runs right in your browser — the ones marked play are live now; the rest are coming soon.
  </p>
  {games.length === 0 ? (
    <p>Coming soon.</p>
  ) : (
    <div>
      {games.map(g => (
        <article data-type="project">
          <div data-type="project-header">
            <a href={`/games/${g.slug}`}>{g.title}</a>
            <span data-type="project-stats">
              {g.interactive ? (
                <span style="font-size: var(--text-xs); color: var(--color-success); border: 1px solid var(--color-success); padding: var(--space-2xs) var(--space-xs); border-radius: var(--radius);">play <span aria-hidden="true">&rsaquo;</span></span>
              ) : (
                <span style="font-size: var(--text-xs); border: 1px solid var(--color-border); padding: var(--space-2xs) var(--space-xs); border-radius: var(--radius);">coming soon</span>
              )}
            </span>
          </div>
          <div data-type="project-description" set:html={render(g.description)} />
        </article>
      ))}
    </div>
  )}
</Base>
