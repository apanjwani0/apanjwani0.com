---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite, getGames } from '../lib/config'
import { render } from '../lib/markdown'
import { itemListJsonLd } from '../lib/jsonld'
import { isPlayableGame } from '../lib/games'

const [site, games] = await Promise.all([
  getSite(Astro.locals),
  getGames(Astro.locals).then(gs => gs.filter(g => g.enabled)),
])
const cspNonce = (Astro.locals as any).cspNonce

// Only playable games have an indexable detail page; the "coming soon"
// placeholders render noindex, so keep them out of the structured item list.
// Same predicate as the sitemap and the detail page's robots meta, so the three
// cannot disagree. The card grid below still shows every enabled game.
const ldJson = itemListJsonLd(
  'Games by Aman Panjwani',
  games.filter(isPlayableGame).map(g => ({ name: g.title, url: `${site.url}/games/${g.slug}` })),
)
---

<Base
  wide
  title="games"
  description="Free browser games — Quintle (a daily five-letter word puzzle), 2048, a seeded maze generator that solves itself, a daily typing race with a shared leaderboard, Hue Hunt (a daily hex-colour guessing game), and a poker trainer with exact equity and pot odds. No downloads, no sign-up."
  keywords="browser games, word game, word guessing game, five letter word game, daily word puzzle, wordle style game, quintle, 2048, 2048 puzzle, sliding tile game, number puzzle, maze generator, maze solver, pathfinding visualizer, bfs, a star, typing game, typing speed test, typing race, daily typing challenge, typing leaderboard, hex color game, color guessing game, guess the hex, daily color game, poker trainer, poker equity calculator, pot odds trainer, poker practice, daily games, daily puzzle, no-download games, playable experiments"
>
  {games.length > 0 && <script nonce={cspNonce} type="application/ld+json" set:html={ldJson} />}
  <h1>games</h1>
  <p data-type="page-intro">
    Browser games and playable experiments — a daily five-letter word puzzle, a game of 2048, a maze that weaves
    itself and then solves itself, a daily typing race where everyone on Earth gets the same passage, a colour-guessing
    game that scores your eye out of 500 each day, and a poker trainer that counts every runout instead of estimating.
    Everything marked play runs right here, no downloads and no sign-up; the rest are on the way. The generative
    pieces that used to live here — the flow field, the flock, the falling sand and friends — moved into
    <a href="/tools/driftfield">Driftfield</a>, where each one still runs live.
  </p>
  {games.length === 0 ? (
    <p>Coming soon.</p>
  ) : (
    <div data-type="card-grid">
      {games.map(g => (
        <article data-type="project">
          <div data-type="project-header">
            <h2 data-type="card-title"><a href={`/games/${g.slug}`}>{g.title}</a></h2>
            <span data-type="project-stats">
              {isPlayableGame(g) ? (
                <span data-type="game-badge" data-live>play <span aria-hidden="true">&rsaquo;</span></span>
              ) : (
                <span data-type="game-badge">coming soon</span>
              )}
            </span>
          </div>
          <div data-type="project-description" set:html={render(g.description)} />
        </article>
      ))}
    </div>
  )}
</Base>

<style>
  /* Status pill on each game card — replaces the previous duplicated inline
     styles; live vs coming-soon differ only by colour. Tokens only. */
  [data-type="game-badge"] {
    font-size: var(--text-xs);
    border: 1px solid var(--color-border);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius);
    white-space: nowrap;
  }

  [data-type="game-badge"][data-live] {
    color: var(--color-success);
    border-color: var(--color-success);
  }

  /* Coming-soon reads as secondary: a muted label, distinct from the green live
     state and from primary body text, so the two badge states are ranked. */
  [data-type="game-badge"]:not([data-live]) {
    color: var(--color-muted);
  }
</style>
