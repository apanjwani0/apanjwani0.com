---
export const prerender = false

import Base from '../layouts/Base.astro'
import { getSite, navLinks } from '../lib/config'
import { isScannerPath, suggestPaths } from '../lib/fuzzy'
import { buildSiteIndex, loadSiteConfigs } from '../lib/site-index'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { shellLinkAttrs } from '../lib/shells'
import '../styles/error-page.css'

// The suggested links are DERIVED from navLinks(), never hand-written: a
// hand-written list is one more consumer of "which sections exist" that no
// predicate reaches — this page advertised /blogs on every 404 for five days
// after the section was gated hidden, because it was the one link list that
// read no flag. navLinks() already applies isBlogsPublic (and whatever gate
// comes next), so this page can no longer disagree with the nav and footer.
const site = await getSite(Astro.locals)
const links = navLinks(site)

// "Did you mean": the pages a mistyped or moved path most likely meant, from
// the same site index the sitemap and llms.txt read, so a suggestion is always
// a real, indexable page. Most 404s are scanners probing for /wp-login.php and
// the like; isScannerPath answers those before the index is even built, and
// suggestPaths returns nothing for a path that resembles no page. The path is
// only compared, never echoed into the page.
const asked = Astro.url.pathname
const suggestions = isScannerPath(asked)
  ? []
  : suggestPaths(asked, buildSiteIndex(await loadSiteConfigs(Astro.locals)))
---

<!-- noindex: an error page should never enter the index (it can be served for any
     unknown URL, and an indexed 404 is a soft-404 in Search Console). -->
<Base title="404" description="That page wandered off — here are a few good places to land instead." noindex>
  <Breadcrumbs items={[{ label: 'home', href: '/' }, { label: 'not found' }]} />
  <section data-type="error-page" aria-labelledby="err-title">
    <p data-type="error-code">404</p>
    <h1 id="err-title">This page drifted off into space.</h1>
    <p data-type="error-lead">
      The link you followed is broken or the page has moved. No harm done —
      here are a few places worth landing instead.
    </p>
    {suggestions.length > 0 && (
      <nav data-type="error-suggest" aria-labelledby="err-suggest-title">
        <p id="err-suggest-title" data-type="error-suggest-title">Did you mean</p>
        <ul>
          {suggestions.map(e => <li><a href={e.u} {...shellLinkAttrs(e.u)}>{e.t}</a></li>)}
        </ul>
      </nav>
    )}
    <nav data-type="error-links" aria-label="Suggested pages">
      <a href="/">home</a>
      {links.map(l => <a href={l.href}>{l.label}</a>)}
    </nav>
    <p data-type="error-help">
      Still not sure where to go? Every section is linked in the footer at the
      bottom of this page, and the home page is always a safe place to start.
    </p>
  </section>
</Base>
