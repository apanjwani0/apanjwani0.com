---
export const prerender = false

import Base from '../layouts/Base.astro'
import ExperienceItem from '../components/ExperienceItem.astro'
import { getExperience } from '../lib/config'

const experience = await getExperience(Astro.locals)
---

<Base
  title="experience"
  description="Aman Panjwani's engineering experience — backend and payments roles building money-movement systems that stay reliable as they scale."
>
  <h1>experience</h1>
  <p data-type="page-intro">
    The roles, teams, and systems I've worked on — backend and payments engineering,
    with a recurring theme of keeping money-movement reliable as it scales.
  </p>
  {experience.map(company => <ExperienceItem company={company} />)}
</Base>
