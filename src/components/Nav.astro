---
import { getSite } from '../lib/config'

interface Props {
  site?: Awaited<ReturnType<typeof getSite>>
}

const { site: siteProp } = Astro.props
const site = siteProp ?? await getSite(Astro.locals)
const current = Astro.url.pathname
// A nav link is "current" when the path matches it exactly or (for section links
// other than home) sits within that section — e.g. /tools/json-tidy → tools.
const isActive = (href: string) =>
  current === href || (href !== '/' && current.startsWith(href + '/'))

// Flatten site.nav into a flat list of links (dropdown children become top-level
// links), matching the home-screen hero-nav style.
const links = site.nav.flatMap((item) => item.children ?? [item])
---

<nav data-type="hero-nav" aria-label="Site sections">
  <a href="/" data-type="hero-wordmark" aria-label={`${site.name} — home`}>{site.handle}</a>
  <span data-type="hero-links">
    {links.map((link) => (
      <a
        href={link.href}
        data-active={isActive(link.href) ? true : undefined}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >{link.label}</a>
    ))}
  </span>
</nav>
