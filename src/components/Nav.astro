---
import { getSite } from '../lib/config'

interface Props {
  site?: Awaited<ReturnType<typeof getSite>>
}

const { site: siteProp } = Astro.props
const site = siteProp ?? await getSite(Astro.locals)
const current = Astro.url.pathname
// A nav link is "current" when the path matches it exactly or (for section links
// other than home) sits within that section — e.g. /tools/json-tidy → tools.
const isActive = (href: string) =>
  current === href || (href !== '/' && current.startsWith(href + '/'))
---

<header>
  <a href="/">{site.handle}</a>
  <nav>
    {site.nav.map((item: any) => (
      'children' in item ? (
        <div data-type="nav-dropdown">
          <button data-type="nav-dropdown-trigger" aria-haspopup="true">{item.label}</button>
          <div data-type="nav-dropdown-menu">
            {item.children.map((child: any) => (
              <a href={child.href} data-active={isActive(child.href) ? true : undefined} aria-current={isActive(child.href) ? 'page' : undefined}>{child.label}</a>
            ))}
          </div>
        </div>
      ) : (
        <a href={item.href} data-active={isActive(item.href) ? true : undefined} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      )
    ))}
  </nav>
</header>
