---
import { getSite } from '../lib/config'

interface Props {
  site?: Awaited<ReturnType<typeof getSite>>
}

const { site: siteProp } = Astro.props
const site = siteProp ?? await getSite(Astro.locals)
const current = Astro.url.pathname

// Flatten any nested groups ("others") so every section is a single inline link —
// one unified nav, no dropdown. Works whatever shape the KV/config nav is in.
const links = site.nav.flatMap((item: any) => ('children' in item ? item.children : [item]))
---

<header>
  <a href="/" data-type="wordmark">{site.handle.slice(0, -1)}<b>{site.handle.slice(-1)}</b></a>
  <nav>
    {links.map((link: any) => (
      <a href={link.href} data-active={current === link.href || (link.href !== '/' && current.startsWith(link.href)) ? true : undefined}>{link.label}</a>
    ))}
  </nav>
</header>
