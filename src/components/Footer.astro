---
/**
 * Site footer — the page-level `contentinfo` landmark the layouts were missing.
 *
 * Rendered on every standard page (see Base.astro / ToolBase.astro); the layouts
 * deliberately skip it on the full-bleed home hero so that flagship stays a single
 * immersive screen. Two columns on a wide screen, one on a phone:
 *   - left, "About the developer": the name (a link home), a short bio
 *     (`site.footerBio`), the identity links and the terms page;
 *   - right, the section links as a vertical list in `nav[aria-label="Footer"]`.
 * It gives every other route three things it lacked:
 *   1. a `contentinfo` landmark (a11y — screen readers can jump to it);
 *   2. a crawlable link mesh to home + every section from every page, including
 *      deep /tools/x and /games/x detail routes that otherwise only linked one
 *      level up via the breadcrumb (SEO — flatter crawl depth, spread equity);
 *   3. visible authorship + a rel="me" identity signal on every page.
 *
 * Serif reads (name, bio), mono operates (label, links). Styling is tokens-only
 * and self-contained here. The last row is a plain "back to top" anchor to
 * `#main-content` (no script), and the contact links are the identity links plus
 * an email and, only when one is configured, a résumé.
 */
import { getSite, navLinks, type Site } from '../lib/config'
import { safeEmailAddress } from '../lib/config-schema'
import { safeExternalUrl, safeInternalPath } from '../lib/security'

interface Props {
  site?: Site
}

const { site: siteProp } = Astro.props
const site = siteProp ?? await getSite(Astro.locals)

// The same flat section list the header renders — one definition, so the two
// can never advertise different sections on the same page.
const links = navLinks(site)

// Same-origin-safe identity links; rel="me" reinforces the home hero's author
// claims on every page. Filtered through the URL allowlist like everywhere else.
const social = (['github', 'linkedin'] as const)
  .map((platform) => [platform, safeExternalUrl(site.social[platform])] as const)
  .filter((entry): entry is readonly ['github' | 'linkedin', string] => Boolean(entry[1]))

// Contact: a mailto from a validated address (never a raw string in an href),
// and a résumé that may be a full https URL or a file on this site.
const email = safeEmailAddress(site.social.email)
const resume = site.resumeUrl ? (safeExternalUrl(site.resumeUrl) ?? safeInternalPath(site.resumeUrl)) : null

---

<footer data-type="site-footer">
  <div data-type="footer-inner">
    <div data-type="footer-about">
      <p data-type="footer-label">About the developer</p>
      {/* Same accessible name as the header wordmark (Nav.astro) — one home
          link, one label, wherever it appears. */}
      <a href="/" data-type="footer-name" aria-label={`${site.name} — home`}>{site.name}</a>
      {site.footerBio && <p data-type="footer-bio">{site.footerBio}</p>}
      {(social.length > 0 || email || resume) && (
        <div data-type="footer-social">
          {social.map(([platform, url]) => (
            <a
              href={url}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label={`${site.name} on ${platform} (opens in a new tab)`}
            >{platform}</a>
          ))}
          {email && <a href={`mailto:${email}`} aria-label={`Email ${site.name}`}>email</a>}
          {resume && <a href={resume} target="_blank" rel="noopener noreferrer" aria-label={`${site.name}'s résumé (opens in a new tab)`}>résumé</a>}
        </div>
      )}
      {/* The as-is terms and what each tool keeps: one page for the site. */}
      <a href="/terms" data-type="footer-terms">terms &amp; privacy</a>
    </div>
    <nav data-type="footer-nav" aria-label="Footer">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    {/* A plain in-page anchor: main has tabindex="-1", so this moves focus there
        too, and it needs no script. */}
    <a href="#main-content" data-type="back-to-top">back to top <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  footer[data-type="site-footer"] {
    /* Sits above the fixed starfield canvas (--z-sky) on pages that show it. */
    position: relative;
    z-index: var(--z-content);
    border-top: 1px solid var(--color-border);
    padding: var(--space-section) var(--space-page-x);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--color-muted);
  }

  div[data-type="footer-inner"] {
    max-width: var(--content-width);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--space-section) var(--space-card);
  }

  /* A phone: one column, the about block first, then the section links. */
  @media (max-width: 40rem) {
    div[data-type="footer-inner"] {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  footer[data-type="site-footer"] div[data-type="footer-about"] {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
    max-width: var(--measure-about);
  }

  footer[data-type="site-footer"] p {
    margin: 0;
  }

  footer[data-type="site-footer"] p[data-type="footer-label"] {
    text-transform: uppercase;
    letter-spacing: var(--label-tracking);
    font-weight: 600;
  }

  footer[data-type="site-footer"] a[data-type="footer-name"] {
    font-family: var(--font-serif);
    font-size: var(--text-card);
    font-weight: 600;
    color: var(--color-text);
  }

  footer[data-type="site-footer"] p[data-type="footer-bio"] {
    font-family: var(--font-serif);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  footer[data-type="site-footer"] nav[data-type="footer-nav"] {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  footer[data-type="site-footer"] div[data-type="footer-social"] {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md) var(--space-card);
  }

  footer[data-type="site-footer"] a {
    color: var(--color-muted);
    text-decoration: none;
  }

  footer[data-type="site-footer"] a:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: var(--underline-offset);
  }

  /* The focus ring is the site-wide one (shared.css); the footer draws no ring
     of its own. */
  footer[data-type="site-footer"] a[data-type="back-to-top"] {
    grid-column: 1 / -1;
    justify-self: start;
  }

  /* A coarse pointer: shared.css makes each link 44px tall, which already
     supplies the space between rows, so the stacks drop their own gaps. */
  @media (pointer: coarse) {
    footer[data-type="site-footer"] nav[data-type="footer-nav"] {
      gap: 0;
    }

    footer[data-type="site-footer"] div[data-type="footer-social"] {
      row-gap: 0;
    }
  }
</style>
