---
/**
 * The hubs' card anatomy (shared.css): card-head (title link, then an optional
 * card-badges group), card-desc, then an optional card-meta pinned to the bottom.
 * The whole card is its link through the title anchor's stretched ::after.
 *
 * Slots: `badges` (the group is rendered only when the slot is passed),
 * `desc` (the description's content), `meta` (the card-meta paragraph, rendered
 * only when the slot produces content). With no `href` the title is plain text (a coming-soon card).
 */
import { shellLinkAttrs } from '../lib/shells'

interface Props {
  title: string
  href?: string | null
  /** Opens in a new tab: adds target, rel and an "(opens in a new tab)" label. */
  external?: boolean
  /** `data-status` on the card. */
  status?: string
  /** Element holding the description: a `p` for plain text, a `div` for rendered markdown. */
  descAs?: 'p' | 'div'
  /** Heading level of the title: 3 when the grid sits under a section's h2. */
  level?: 2 | 3
}

const { title, href, external = false, status, descAs = 'div', level = 2 } = Astro.props
const Desc = descAs
const Title = level === 3 ? 'h3' : 'h2'
// Rendered first and kept only when it has content: a slot passed through a
// condition (`{x && <Fragment slot="meta">…}`) still counts for slots.has(),
// and an empty card-meta keeps its top padding and pushes the card taller.
const meta = Astro.slots.has('meta') ? (await Astro.slots.render('meta')).trim() : ''
---

<li data-status={status}>
  <div data-type="card-head">
    <Title data-type="card-title">
      {href
        ? <a
            href={href}
            {...shellLinkAttrs(href)}
            {...(external ? { target: '_blank', rel: 'noopener noreferrer', 'aria-label': `${title} (opens in a new tab)` } : {})}
          >{title}</a>
        : title}
    </Title>
    {Astro.slots.has('badges') && <span data-type="card-badges"><slot name="badges" /></span>}
  </div>
  <Desc data-type="card-desc"><slot name="desc" /></Desc>
  {meta && <p data-type="card-meta" set:html={meta} />}
</li>
