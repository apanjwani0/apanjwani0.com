---
import type { Project } from '../config/projects'
import type { GitHubStats } from '../lib/github'
import { render } from '../lib/markdown'
import { appendPathToExternalUrl, safeExternalUrl } from '../lib/security'

interface Props {
  project: Project
  stats?: GitHubStats
}

const { project, stats } = Astro.props
const projectUrl = safeExternalUrl(project.url)
const stargazersUrl = appendPathToExternalUrl(project.url, 'stargazers')
const forksUrl = appendPathToExternalUrl(project.url, 'forks')
---

<article data-type="project">
  <div data-type="project-header">
    <h2 data-type="card-title">
      {projectUrl
        ? <a href={projectUrl} target="_blank" rel="noopener noreferrer">{project.title}</a>
        : project.title}
    </h2>
    {stats && stargazersUrl && forksUrl && (
      <span data-type="project-stats">
        <a
          href={stargazersUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${stats.stars.toLocaleString()} stargazers on GitHub`}
        >
          <span aria-hidden="true">★ {stats.stars.toLocaleString()}</span>
        </a>
        <a
          href={forksUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${stats.forks.toLocaleString()} forks on GitHub`}
        >
          <span aria-hidden="true">⑂ {stats.forks.toLocaleString()}</span>
        </a>
      </span>
    )}
  </div>
  <div data-type="project-description" set:html={render(project.description)} />
  {project.tags.length > 0 && (
    <p data-type="project-tags">{project.tags.join(', ')}</p>
  )}
</article>
