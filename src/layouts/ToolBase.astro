---
import { getSite } from '../lib/config'
import { ogImageMeta } from '../lib/og'
import Nav from '../components/Nav.astro'
import Head from '../components/Head.astro'
import '../styles/shared.css'

interface Props {
  toolTitle?: string
  seoTitle?: string
  metaDescription?: string
  keywords?: string
  /** Generated share card from ogCardPath(); falls back to the avatar if absent. */
  ogCard?: string
}

const site = await getSite(Astro.locals)
const { toolTitle, seoTitle, metaDescription, keywords, ogCard } = Astro.props
const pageTitle = seoTitle || (toolTitle ? `${toolTitle} · ${site.name}` : `${site.name} · tools`)
// Fall back to a tool-appropriate sentence rather than the site's role line
// (`site.tagline`), which reads as nonsense as a tool page's meta description.
const description =
  metaDescription ||
  (toolTitle
    ? `${toolTitle} — a fast, free, no-login tool that runs entirely in your browser, by ${site.name}.`
    : `Fast, free, browser-based developer tools by ${site.name}.`)
const canonicalURL = new URL(Astro.url.pathname, site.url).href
// Absolute URL + dimensions for the social-share preview image, matching
// Base.astro (shared helper) so tool links render a preview card, not a bare link.
const ogImage = ogImageMeta(site, ogCard, toolTitle)
---

<!doctype html>
<html lang="en" data-theme={site.theme}>
  <head>
    <Head
      pageTitle={pageTitle}
      description={description}
      canonicalURL={canonicalURL}
      siteName={site.name}
      keywords={keywords}
      image={ogImage.src}
      imageWidth={ogImage.width}
      imageHeight={ogImage.height}
      imageAlt={ogImage.alt}
      imageType={ogImage.type}
      twitterCard={ogImage.card}
      handle={site.handle}
      loadFonts={false}
      clientRouter={false}
    />
  </head>
  <body>
    <a href="#main-content" data-type="skip-link">Skip to content</a>
    <Nav site={site} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <script src="/oat.min.js" defer></script>
    <script>
      // Nav height sync, hide-on-scroll, and StarField mount — shared verbatim
      // with Base.astro, so it lives in one module (src/lib/nav-ui.ts).
      import { initNav } from '../lib/nav-ui.ts'
      import { initAnalytics } from '../lib/analytics-client.ts'
      initNav()
      initAnalytics()
    </script>
  </body>
</html>

<style is:global>
  body {
    font-family: var(--font-serif);
    color: var(--color-text);
    /* Match Base.astro's global.css body: paint the themed background token so
       tool pages show the correct dark surface before the fixed starfield canvas
       mounts (and if JS is disabled), instead of the UA default. The canvas is a
       fixed child that paints over this, so it's purely a pre-paint fallback. */
    background-color: var(--color-bg);
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
