---
import { getSite } from '../lib/config'
import Nav from '../components/Nav.astro'
import Head from '../components/Head.astro'
import '../styles/shared.css'

interface Props {
  toolTitle?: string
  seoTitle?: string
  metaDescription?: string
  keywords?: string
}

const site = await getSite(Astro.locals)
const { toolTitle, seoTitle, metaDescription, keywords } = Astro.props
const pageTitle = seoTitle || (toolTitle ? `${toolTitle} · ${site.name}` : `${site.name} · tools`)
// Fall back to a tool-appropriate sentence rather than the site's role line
// (`site.tagline`), which reads as nonsense as a tool page's meta description.
const description =
  metaDescription ||
  (toolTitle
    ? `${toolTitle} — a fast, free, no-login tool that runs entirely in your browser, by ${site.name}.`
    : `Fast, free, browser-based developer tools by ${site.name}.`)
const canonicalURL = new URL(Astro.url.pathname, site.url).href
// Absolute URL + dimensions for the social-share preview image, matching
// Base.astro so shared tool links render a preview card, not a bare link.
const ogImage = new URL(site.avatar, site.url).href
const ogImageWidth = 320
const ogImageHeight = 468
---

<!doctype html>
<html lang="en" data-theme={site.theme}>
  <head>
    <Head
      pageTitle={pageTitle}
      description={description}
      canonicalURL={canonicalURL}
      siteName={site.name}
      keywords={keywords}
      image={ogImage}
      imageWidth={ogImageWidth}
      imageHeight={ogImageHeight}
    />
  </head>
  <body>
    <a href="#main-content" data-type="skip-link">Skip to content</a>
    <star-field data-type="starfield" aria-hidden="true"></star-field>
    <Nav site={site} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <script src="/oat.min.js" defer></script>
    <script>
      function syncNavHeight() {
        const nav = document.querySelector('[data-type="hero-nav"]')
        if (nav) {
          document.documentElement.style.setProperty('--nav-h', nav.offsetHeight + 'px')
        }
      }
      let lastScroll = 0
      function onScroll() {
        const nav = document.querySelector('[data-type="hero-nav"]')
        if (!nav) return
        const current = window.scrollY
        if (current > lastScroll && current > nav.offsetHeight + 20) {
          nav.setAttribute('data-nav-hidden', '')
        } else if (current < lastScroll) {
          nav.removeAttribute('data-nav-hidden')
        }
        lastScroll = current
      }
      function setup() {
        syncNavHeight()
        import('../components/home/StarField.ts')
        window.addEventListener('scroll', onScroll, { passive: true })
        window.addEventListener('resize', syncNavHeight)
      }
      document.addEventListener('astro:page-load', setup)
    </script>
  </body>
</html>

<style is:global>
  body {
    font-family: var(--font-serif);
    color: var(--color-text);
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
