---
import { getSite } from '../lib/config'
import { ogImageMeta } from '../lib/og'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import Head from '../components/Head.astro'
import '../styles/global.css'

interface Props {
  title?: string
  /** A complete, self-contained <title>. Used verbatim — no site-name suffix.
   *  Product pages (games) pass their SEO title here: in a search result the
   *  trailing "· Name" only eats the pixels Google allows before truncating,
   *  and pushes the actual keywords out. Matches how ToolBase treats seoTitle. */
  seoTitle?: string
  description?: string
  noindex?: boolean
  keywords?: string
  bare?: boolean
  wide?: boolean
  fluid?: boolean
  starfield?: boolean
  loadFonts?: boolean
  clientRouter?: boolean
  ogType?: 'website' | 'article'
  publishedTime?: string
  /** Generated share card from ogCardPath(); falls back to the avatar if absent. */
  ogCard?: string
  /** The page's canonical path when it is not the requested one — a page that
   *  renders any query string (the kit permalink) names the page it stands for. */
  canonicalPath?: string
}

const site = await getSite(Astro.locals)
const {
  title,
  seoTitle,
  description = site.tagline,
  noindex = false,
  keywords,
  bare = false,
  wide = false,
  fluid = false,
  starfield = true,
  loadFonts = true,
  clientRouter = true,
  ogType = 'website',
  publishedTime,
  ogCard,
  canonicalPath,
} = Astro.props
// A supplied seoTitle is already complete and is used as-is. Otherwise a section
// title gets the site-name suffix (it is what identifies "projects" as this
// site's), and home (no title at all) gets a descriptive title with the role line
// so the most-linked page's <title>/og:title isn't just a bare name.
const pageTitle = seoTitle || (title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`)
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, site.url).href
// Absolute URL + dimensions for the social-share preview image (link cards on
// Slack, X, etc.). Shared with ToolBase.astro via one helper so the share-image
// dimensions have a single source of truth.
const ogImage = ogImageMeta(site, ogCard, title)
---

<!doctype html>
<html lang="en" data-theme={site.theme} data-theme-default={site.theme}>
  <head>
    <Head
      pageTitle={pageTitle}
      description={description}
      canonicalURL={canonicalURL}
      siteName={site.name}
      noindex={noindex}
      keywords={keywords}
      image={ogImage.src}
      imageWidth={ogImage.width}
      imageHeight={ogImage.height}
      imageAlt={ogImage.alt}
      imageType={ogImage.type}
      twitterCard={ogImage.card}
      ogType={ogType}
      publishedTime={publishedTime}
      handle={site.handle}
      loadFonts={loadFonts}
      clientRouter={clientRouter}
      theme={site.theme}
    />
  </head>
  <body>
    <a href="#main-content" data-type="skip-link">Skip to content</a>
    {starfield && <star-field data-type="starfield" aria-hidden="true"></star-field>}
    <Nav site={site} bare={bare} />
    <main
      id="main-content"
      tabindex="-1"
      data-bare={bare ? '' : undefined}
      data-fluid={fluid ? '' : undefined}
      data-width={wide ? 'wide' : undefined}
    >
      <slot />
    </main>
    {/* Skipped on the full-bleed home hero (bare) so it stays a single immersive
        screen; present on every other route as the contentinfo landmark. */}
    {!bare && <Footer site={site} />}
    <script src="/oat.min.js" defer></script>
    <script>
      // Nav height sync, hide-on-scroll, and StarField mount — shared verbatim
      // with ToolBase.astro, so it lives in one module (src/lib/nav-ui.ts).
      // initSiteUI (src/lib/site-ui.ts) is the site chrome: the swap patch that
      // keeps the visitor's theme across ClientRouter navigations, plus the
      // theme, find, kit and motion entry points.
      import { initNav } from '../lib/nav-ui.ts'
      import { initAnalytics } from '../lib/analytics-client.ts'
      import { initSiteUI } from '../lib/site-ui.ts'
      initNav()
      initAnalytics()
      initSiteUI()
    </script>
  </body>
</html>
