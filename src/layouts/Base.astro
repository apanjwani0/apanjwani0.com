---
import { getSite } from '../lib/config'
import Nav from '../components/Nav.astro'
import Head from '../components/Head.astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  noindex?: boolean
  keywords?: string
  bare?: boolean
  wide?: boolean
  fluid?: boolean
  starfield?: boolean
  loadFonts?: boolean
  clientRouter?: boolean
  ogType?: 'website' | 'article'
  publishedTime?: string
}

const site = await getSite(Astro.locals)
const {
  title,
  description = site.tagline,
  noindex = false,
  keywords,
  bare = false,
  wide = false,
  fluid = false,
  starfield = true,
  loadFonts = true,
  clientRouter = true,
  ogType = 'website',
  publishedTime,
} = Astro.props
// Home (no explicit title) gets a descriptive title with the role line so the
// most-linked page's <title>/og:title isn't just a bare name.
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline}`
const canonicalURL = new URL(Astro.url.pathname, site.url).href
// Absolute URL for the social-share preview image (link cards on Slack, X, etc.).
// Dimensions match public/avatar.webp (320×468) so scrapers get a complete
// og:image object and reserve the right aspect ratio without a fetch.
const ogImage = new URL(site.avatar, site.url).href
const ogImageWidth = 320
const ogImageHeight = 468
---

<!doctype html>
<html lang="en" data-theme={site.theme}>
  <head>
    <Head
      pageTitle={pageTitle}
      description={description}
      canonicalURL={canonicalURL}
      siteName={site.name}
      noindex={noindex}
      keywords={keywords}
      image={ogImage}
      imageWidth={ogImageWidth}
      imageHeight={ogImageHeight}
      ogType={ogType}
      publishedTime={publishedTime}
      handle={site.handle}
      loadFonts={loadFonts}
      clientRouter={clientRouter}
    />
  </head>
  <body>
    <a href="#main-content" data-type="skip-link">Skip to content</a>
    {starfield && <star-field data-type="starfield" aria-hidden="true"></star-field>}
    <Nav site={site} />
    <main
      id="main-content"
      tabindex="-1"
      data-bare={bare ? '' : undefined}
      data-fluid={fluid ? '' : undefined}
      data-width={wide ? 'wide' : undefined}
    >
      <slot />
    </main>
    <script src="/oat.min.js" defer></script>
    <script>
      // Nav height sync, hide-on-scroll, and StarField mount — shared verbatim
      // with ToolBase.astro, so it lives in one module (src/lib/nav-ui.ts).
      import { initNav } from '../lib/nav-ui.ts'
      import { initAnalytics } from '../lib/analytics-client.ts'
      initNav()
      initAnalytics()
    </script>
  </body>
</html>
